# Copia este archivo a .env y pega las claves de Supabase.
# Project Settings → API Keys

# Frontend (catálogo + dashboard en el navegador)
# Project URL (https://xxxx.supabase.co, no una API key)
PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Backend / servidor (dashboard admin, nunca en el cliente)
SUPABASE_SECRET_KEY=sb_secret_...
