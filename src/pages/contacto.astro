---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { buildWhatsAppUrl, generalWhatsAppMessage } from '../data/site';
import { getContactPageCopy } from '../lib/contact-page';
import { getSiteSettings } from '../lib/site-settings';

const settings = await getSiteSettings();
const contact = await getContactPageCopy();
const waUrl = buildWhatsAppUrl(generalWhatsAppMessage(contact.whatsappContext), settings.whatsappNumber);
---

<BaseLayout
  title={contact.title}
  description={contact.description}
>
  <section class="page-hero">
    <div class="container anim-fade-up">
      <p class="eyebrow">{contact.eyebrow}</p>
      <h1 class="section-title">{contact.title}</h1>
      <hr class="divider" />
      <p class="section-lead">{contact.lead}</p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container contact">
      <article class="contact__panel anim-fade-up">
        <h2>{contact.whatsappTitle}</h2>
        <p class="contact__number">{settings.whatsappDisplay}</p>
        <p>{contact.whatsappText}</p>
        <WhatsAppButton
          message={generalWhatsAppMessage(contact.whatsappContext)}
          label={contact.whatsappCta}
          variant="gold"
        />
      </article>

      <article class="contact__panel anim-fade-up-delay">
        <h2>{contact.infoTitle}</h2>
        <ul class="contact__list">
          <li>
            <span>{contact.emailLabel}</span>
            <a href={`mailto:${settings.email}`}>{settings.email}</a>
          </li>
          <li>
            <span>{contact.locationLabel}</span>
            <p>{contact.location}</p>
          </li>
          <li>
            <span>{contact.hoursLabel}</span>
            <p>{contact.hours}</p>
          </li>
        </ul>
        <a class="btn btn--outline" href={waUrl} target="_blank" rel="noopener noreferrer">
          {contact.infoCta}
        </a>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-block: var(--space-xl) var(--space-md);
    background: radial-gradient(ellipse at 70% 0%, rgba(201, 162, 39, 0.12), transparent 45%);
  }

  .contact {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .contact__panel {
    padding: clamp(1.5rem, 4vw, 2.25rem);
    border: 1px solid rgba(201, 162, 39, 0.18);
    background: var(--color-black-soft);
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .contact__panel h2 {
    font-size: 1.8rem;
  }

  .contact__number {
    font-family: var(--font-display);
    font-size: 2rem;
    color: var(--color-gold-bright);
    letter-spacing: 0.04em;
  }

  .contact__list {
    display: grid;
    gap: 1rem;
  }

  .contact__list span {
    display: block;
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 0.25rem;
  }

  .contact__list a:hover {
    color: var(--color-gold-bright);
  }

  @media (max-width: 760px) {
    .contact {
      grid-template-columns: 1fr;
    }
  }
</style>
