  @media (max-width: 960px) {
    .benefits__grid {
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem 0;
    }

    .benefits__item:nth-child(2) {
      border-right: none;
    }

    .spotlight {
      grid-template-columns: minmax(0, 1.1fr) 1fr;
      max-width: none;
    }

    .spotlight__media {
