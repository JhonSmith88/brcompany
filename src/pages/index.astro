---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import BenefitIcon from '../components/BenefitIcon.astro';
import { getAllProducts, getFeaturedProducts } from '../lib/catalog';
import CollectionIcon from '../components/CollectionIcon.astro';
import { getHeroCopy, getHeroSlides, getHomeBenefits, getHomeCarousel, getHomeMarks, getOrderCopy, getSpotlightCopy, getVitrinaCopy, getVitrinaItems, resolveSpotlightProduct, splitHeroTitle } from '../lib/home';
import { site, generalWhatsAppMessage, formatPrice } from '../data/site';

const products = await getAllProducts();
const vitrinaCopy = await getVitrinaCopy();
const vitrinaItems = await getVitrinaItems();
const vitrinaActive = vitrinaItems.length > 1 ? 1 : 0;
const featured = await getFeaturedProducts();
const heroSlides = await getHeroSlides();
const heroCopy = await getHeroCopy();
const heroTitle = splitHeroTitle(heroCopy.title);
const spotlightCopy = await getSpotlightCopy();
const spotlight = resolveSpotlightProduct(products, spotlightCopy.productCodigo);
const managedMarks = await getHomeMarks();
const brandMarks = managedMarks ?? [...new Set(featured.map((p) => p.marca))];
const featuredOthers = featured.filter((product) => !spotlight || product.codigo !== spotlight.codigo);
const managedCarousel = await getHomeCarousel(products);
const carouselProducts = managedCarousel ?? featuredOthers.slice(0, 8);

const benefits = await getHomeBenefits();
const spotlightSpecs = spotlight?.caracteristicas ?? [];
const orderCopy = await getOrderCopy();
---

<BaseLayout>
  {/* Hero: full-bleed brand moment */}
  <section class="hero" data-hero>
    <div class="hero__media" aria-hidden="true">
      {
        heroSlides.map((slide, index) => (
          <div class:list={['hero__slide', { 'is-active': index === 0 }]} data-hero-slide>
            <img
              src={slide.src}
              alt={slide.alt}
              width="1800"
              height="1200"
              fetchpriority={index === 0 ? 'high' : 'low'}
              loading={index === 0 ? 'eager' : 'lazy'}
            />
          </div>
        ))
      }
    </div>
    <div class="hero__veil"></div>
    <div class="hero__content">
      <p class="hero__eyebrow">{heroCopy.eyebrow}</p>
      <h1 class="hero__name">
        {heroTitle.prefix ? <span class="hero__name-rb">{heroTitle.prefix}</span> : null}<span class="hero__name-company">{heroTitle.rest}</span>
      </h1>
      <p class="hero__lead">{heroCopy.lead}</p>
      <div class="hero__actions">
        <a class="btn btn--outline hero__cta" href={heroCopy.ctaHref}>
          {heroCopy.ctaLabel}
          <span class="hero__cta-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
    <div class="hero__dots" role="tablist" aria-label="Imágenes del hero">
      {
        heroSlides.map((_, index) => (
          <button
            type="button"
            class:list={[{ 'is-active': index === 0 }]}
            aria-label={`Mostrar imagen ${index + 1}`}
            data-hero-dot
            data-index={index}
          />
        ))
      }
    </div>
  </section>

  {
    brandMarks.length > 0 && (
      <div class="marks" aria-hidden="true">
        <div class="marks__track">
          {[...brandMarks, ...brandMarks].map((brand) => (
            <span>{brand}</span>
          ))}
        </div>
      </div>
    )
  }

  {
    benefits.length > 0 && (
      <section class="benefits" aria-label="Beneficios">
        <div class="container benefits__grid" style={`--benefits-count: ${benefits.length}`}>
          {benefits.map((item) => (
            <div class="benefits__item">
              <span class="benefits__icon" aria-hidden="true">
                <BenefitIcon icon={item.icon} />
              </span>
              <div>
                <h2>{item.title}</h2>
                <p>{item.text}</p>
              </div>
            </div>
          ))}
        </div>
      </section>
    )
  }

  {
    vitrinaItems.length > 0 && (
      <section class="section collections">
        <div class="container">
          <header class="collections__head">
            <div>
              <p class="collections__eyebrow">{vitrinaCopy.eyebrow}</p>
              <h2 class="collections__title">
                {vitrinaCopy.title}
                {vitrinaCopy.titleEm ? (
                  <>
                    {' '}
                    <em>{vitrinaCopy.titleEm}</em>
                  </>
                ) : null}
              </h2>
            </div>
            <a class="collections__all" href={vitrinaCopy.ctaHref}>
              {vitrinaCopy.ctaLabel}
              <span aria-hidden="true">→</span>
            </a>
          </header>

          <div class="coverflow" data-coverflow>
            <div class="coverflow__stage">
              <div class="coverflow__world">
                <div class="coverflow__floor" aria-hidden="true"></div>
                {vitrinaItems.map((category, index) => (
                  <article
                    class:list={['coverflow__card', { 'is-active': index === vitrinaActive }]}
                    data-coverflow-card
                    data-index={index}
                    data-pos={index - vitrinaActive}
                  >
                    <a href={category.href} draggable="false">
                      <img
                        class="coverflow__photo"
                        src={category.imagen}
                        alt=""
                        width="720"
                        height="960"
                        loading="lazy"
                        decoding="async"
                        draggable="false"
                      />
                      <span class="coverflow__shade"></span>
                      <span class="coverflow__body">
                        <span class="coverflow__num">{String(index + 1).padStart(2, '0')}</span>
                        <h3>{category.nombre}</h3>
                        <span class="coverflow__link">
                          {vitrinaCopy.cardLabel}
                          <span aria-hidden="true">→</span>
                        </span>
                      </span>
                    </a>
                    <span class="coverflow__badge" aria-hidden="true">
                      <CollectionIcon icon={category.icono} />
                    </span>
                  </article>
                ))}
              </div>
            </div>

            <button type="button" class="coverflow__nav coverflow__nav--prev" aria-label="Anterior" data-coverflow-prev>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <path d="M14.5 6.5L9 12l5.5 5.5" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </button>
            <button type="button" class="coverflow__nav coverflow__nav--next" aria-label="Siguiente" data-coverflow-next>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <path d="M9.5 6.5L15 12l-5.5 5.5" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </button>
          </div>

          <div class="coverflow__pager" data-coverflow-pager style={`--active: ${vitrinaActive}`}>
            <span class="coverflow__pager-bar" data-coverflow-bar></span>
            {vitrinaItems.map((category, index) => (
              <button
                type="button"
                class:list={[{ 'is-active': index === vitrinaActive }]}
                aria-label={category.nombre}
                data-coverflow-dot
                data-index={index}
              />
            ))}
          </div>
          <p class="coverflow__hint">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M10 9.5V7.2a1.4 1.4 0 012.8 0V11M12.8 10.2V9a1.2 1.2 0 012.4 0v2.4M15.2 10.6v-.6a1.1 1.1 0 012.2 0V13c0 3.2-1.7 5.6-5.2 5.6h-.8c-2.4 0-4.4-1.4-5.2-3.6L5.4 12a1.1 1.1 0 011.9-1.1L9 13" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            <span class="coverflow__hint-copy coverflow__hint-copy--desktop">{vitrinaCopy.hint}</span>
            <span class="coverflow__hint-copy coverflow__hint-copy--tablet">{vitrinaCopy.hintTablet}</span>
          </p>

          <nav class="vitrina-m" aria-label={vitrinaCopy.eyebrow}>
            {vitrinaItems.map((category) => (
              <a class={`vitrina-m__tile vitrina-m__tile--${category.slug}`} href={category.href}>
                <img src={category.imagen} alt="" width="720" height="960" loading="lazy" decoding="async" />
                <span class="vitrina-m__shade"></span>
                <span class="vitrina-m__meta">
                  <span class="vitrina-m__name">{category.nombre}</span>
                  <span class="vitrina-m__go">
                    {vitrinaCopy.cardLabel}
                    <span aria-hidden="true">→</span>
                  </span>
                </span>
              </a>
            ))}
          </nav>
        </div>
      </section>
    )
  }

  <aside class="cf-tuner" data-cf-tuner hidden>
    <div class="cf-tuner__head">
      <p>Vitrina 3D</p>
      <button type="button" data-cf-collapse aria-label="Minimizar">−</button>
    </div>
    <form class="cf-tuner__body" data-cf-form></form>
    <div class="cf-tuner__actions">
      <button type="button" data-cf-copy>Copiar CSS</button>
      <button type="button" data-cf-reset>Restablecer</button>
    </div>
  </aside>

  {/* Featured: spotlight + secondary strip */}
  {
    spotlight && (
      <section class="section featured">
        <div class="container">
          <p class="eyebrow">{spotlightCopy.eyebrow}</p>
          <h2 class="section-title">{spotlightCopy.title}</h2>
          <hr class="divider" />

          <article class:list={['spotlight', { 'spotlight--no-specs': spotlightSpecs.length === 0 }]}>
            <a class="spotlight__media" href={`/catalogo/${spotlight.categoriaSlug}/${spotlight.slug}`}>
              <img
                src={spotlight.imagenPrincipal.full}
                alt={spotlight.imagenPrincipal.alt}
                width="1200"
                height="900"
                loading="lazy"
                decoding="async"
              />
            </a>
            <div class="spotlight__body">
              <p class="spotlight__brand">{spotlight.marca}</p>
              <h3 class="spotlight__title">
                <a href={`/catalogo/${spotlight.categoriaSlug}/${spotlight.slug}`}>
                  {spotlight.nombre}
                </a>
              </h3>
              <p class="spotlight__code">Código {spotlight.codigo}</p>
              <p class="spotlight__desc">{spotlight.descripcion}</p>
              <div class="price">
                <span class="price__current">{formatPrice(spotlight.precioReal)}</span>
                {spotlight.descuento > 0 && (
                  <>
                    <span class="price__original">{formatPrice(spotlight.precioOriginal)}</span>
                    <span class="price__discount">-{spotlight.descuento}%</span>
                  </>
                )}
              </div>
              <a
                class="btn btn--outline spotlight__link"
                href={`/catalogo/${spotlight.categoriaSlug}/${spotlight.slug}`}
              >
                {spotlightCopy.ctaLabel}
                <span class="spotlight__link-arrow" aria-hidden="true">→</span>
              </a>
            </div>

            {spotlightSpecs.length > 0 && (
              <ul class="spotlight__specs">
                {spotlightSpecs.map((spec) => (
                  <li>
                    <span class="spotlight__spec-icon" aria-hidden="true">
                      <BenefitIcon icon={spec.icon} />
                    </span>
                    <div>
                      <strong>{spec.title}</strong>
                      <span>{spec.text}</span>
                    </div>
                  </li>
                ))}
              </ul>
            )}
          </article>

          {carouselProducts.length > 0 && (
            <div class="carousel" data-carousel>
              <button
                type="button"
                class="carousel__nav carousel__nav--prev"
                aria-label="Anterior"
                data-carousel-prev
              >
                ‹
              </button>
              <div class="carousel__track" data-carousel-track>
                {carouselProducts.map((product) => (
                  <div class="carousel__slide">
                    <ProductCard product={product} />
                  </div>
                ))}
              </div>
              <button
                type="button"
                class="carousel__nav carousel__nav--next"
                aria-label="Siguiente"
                data-carousel-next
              >
                ›
              </button>
            </div>
          )}
        </div>
      </section>
    )
  }

  {/* Order close: typographic, not a card panel */}
  <section class="order">
    <div class="order__media" aria-hidden="true">
      <img src={orderCopy.imageUrl} alt="" width="1600" height="900" loading="lazy" decoding="async" />
    </div>
    <div class="order__veil"></div>
    <div class="container order__inner">
      <h2 class="order__title">
        {orderCopy.title}
        {orderCopy.titleEm && <em> {orderCopy.titleEm}</em>}
      </h2>
      <p class="order__lead">{orderCopy.lead}</p>
      <WhatsAppButton
        message={generalWhatsAppMessage(orderCopy.ctaContext)}
        label={orderCopy.ctaLabel}
        variant="gold"
        class="order__cta"
      />
    </div>
  </section>
</BaseLayout>

<style>
  /* --- Hero --- */
  .hero {
    position: relative;
    min-height: min(70dvh, 36rem);
    display: grid;
    align-items: end;
    overflow: hidden;
  }

  .hero__media {
    position: absolute;
    inset: 0;
  }

  .hero__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.9s ease;
  }

  .hero__slide.is-active {
    opacity: 1;
  }

  .hero__slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 32%;
  }

  .hero__veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(
        105deg,
        rgb(8 8 8 / 0.92) 0%,
        rgb(8 8 8 / 0.72) 42%,
        rgb(8 8 8 / 0.35) 100%
      ),
      linear-gradient(180deg, transparent 40%, rgb(5 5 5 / 0.95) 100%);
  }

  .hero__content {
    position: relative;
    z-index: 2;
    width: min(100% - 2rem, var(--max-width));
    margin-inline: auto;
    padding-block: clamp(2rem, 6vh, 3.5rem) clamp(2.5rem, 7vh, 4.5rem);
    max-width: 34rem;
    margin-left: max(1rem, calc((100% - var(--max-width)) / 2));
  }

  .hero__eyebrow {
    font-size: 0.7rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 0.9rem;
  }

  .hero__name {
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 5.5vw, 3.4rem);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-gold-bright);
    line-height: 1.05;
    margin-bottom: 0.9rem;
  }

  .hero__name-company {
    color: var(--color-white);
  }

  .hero__lead {
    color: var(--color-silver);
    max-width: 28ch;
    font-size: 1.05rem;
    line-height: 1.55;
    margin-bottom: 1.5rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .hero__cta {
    background: var(--color-black);
    border-color: var(--color-gold);
    color: var(--color-gold-bright);
    gap: 0.85rem;
  }

  .hero__cta-arrow {
    font-size: 1.35em;
    line-height: 1;
    font-weight: 400;
  }

  .hero__cta:hover {
    background: var(--color-black-elevated);
    color: var(--color-gold-bright);
  }

  .hero__dots {
    position: absolute;
    left: 50%;
    bottom: 1.25rem;
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    gap: 0.55rem;
  }

  .hero__dots button {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: rgb(200 200 200 / 0.45);
    transition:
      background var(--transition),
      transform var(--transition);
  }

  .hero__dots button.is-active {
    background: var(--color-gold);
    transform: scale(1.25);
  }

  /* --- Brand marks marquee --- */
  .marks {
    border-block: 1px solid rgb(201 162 39 / 0.16);
    background: var(--color-black-soft);
    overflow: hidden;
    padding-block: 0.95rem;
  }

  .marks__track {
    display: flex;
    width: max-content;
    gap: 3.5rem;
    padding-inline: 1.5rem;
  }

  .marks__track span {
    font-family: var(--font-display);
    font-size: 1.05rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-silver-dim);
    white-space: nowrap;
  }

  /* --- Benefits bar --- */
  .benefits {
    border-bottom: 1px solid rgb(201 162 39 / 0.14);
    background: #080808;
    padding-block: 2rem;
  }

  .benefits__grid {
    display: grid;
    grid-template-columns: repeat(var(--benefits-count, 4), minmax(0, 1fr));
  }

  .benefits__item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.45rem 1.2rem;
    min-width: 0;
  }

  .benefits__item:not(:last-child) {
    border-right: 1px solid rgb(200 200 200 / 0.18);
  }

  .benefits__icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    flex-shrink: 0;
    color: var(--color-gold);
  }

  .benefits__icon svg {
    width: 2rem;
    height: 2rem;
  }

  .benefits__item h2 {
    font-family: var(--font-body);
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-white);
    margin-bottom: 0.28rem;
    line-height: 1.25;
  }

  .benefits__item p {
    font-size: 0.95rem;
    color: var(--color-silver-dim);
    line-height: 1.35;
  }

  /* --- Collections 3D coverflow --- */
  .collections {
    --cf-bg-x: 37%;
    --cf-bg-y: 80%;
    --cf-bg-size: 100%;
    position: relative;
    overflow: hidden;
    background-color: #050505;
    background-image:
      linear-gradient(180deg, rgb(5 5 5 / 0.28) 0%, rgb(5 5 5 / 0.08) 38%, rgb(5 5 5 / 0.4) 100%),
      url('/collections-bg.png');
    background-repeat: no-repeat, no-repeat;
    background-position: center, var(--cf-bg-x) var(--cf-bg-y);
    background-size: cover, var(--cf-bg-size) auto;
  }

  .collections__head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .collections__eyebrow {
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 0.55rem;
  }

  .collections__title {
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 500;
  }

  .collections__title em {
    font-style: italic;
    color: var(--color-gold-bright);
  }

  .collections__all {
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-gold);
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding-bottom: 0.35rem;
    white-space: nowrap;
  }

  .collections__all:hover {
    color: var(--color-gold-bright);
  }

  .coverflow {
    --cf-perspective: 1800px;
    --cf-origin-y: 40%;
    --cf-scene-rx: 0deg;
    --cf-card-w: clamp(18rem, 25.1vw, 22.6rem);
    --cf-card-h: clamp(26rem, 36.1vw, 32.5rem);
    --cf-origin: 50% 50%;
    --cf-c1-x: clamp(-34.2rem, -38vw, -22rem);
    --cf-c1-z: -4px;
    --cf-c1-ry: -23.5deg;
    --cf-c1-s: 0.96;
    --cf-c1-b: 0.75;
    --cf-c2-x: clamp(-12.4rem, -13.75vw, -9rem);
    --cf-c2-z: 48px;
    --cf-c2-ry: -11.5deg;
    --cf-c2-s: 1.05;
    --cf-c2-b: 0.76;
    --cf-c3-x: clamp(7.5rem, 11.4vw, 10.3rem);
    --cf-c3-z: 94px;
    --cf-c3-ry: 18deg;
    --cf-c3-s: 0.94;
    --cf-c3-b: 0.76;
    --cf-c4-x: clamp(20rem, 33.8vw, 30.4rem);
    --cf-c4-z: 68px;
    --cf-c4-ry: 10deg;
    --cf-c4-s: 0.9;
    --cf-c4-b: 0.58;
    --cf-scale-hover: 0.98;
    --cf-bright-hover: 0.88;
    --cf-duration: 720ms;
    --cf-floor: 0.12;
    position: relative;
    touch-action: pan-y;
  }

  .coverflow__stage {
    position: relative;
    height: clamp(30rem, 42vw, 38rem);
    perspective: var(--cf-perspective);
    perspective-origin: 50% var(--cf-origin-y);
    transform-style: preserve-3d;
    z-index: 0;
    touch-action: pan-y;
    user-select: none;
    cursor: grab;
  }

  .coverflow__stage.is-dragging {
    cursor: grabbing;
  }

  .coverflow__world {
    position: relative;
    height: 100%;
    transform-style: preserve-3d;
    transform-origin: 50% 85%;
    transform: rotateX(var(--cf-scene-rx));
    transition: transform var(--cf-duration) cubic-bezier(0.22, 1, 0.36, 1);
  }

  .coverflow__floor {
    position: absolute;
    left: 10%;
    right: 10%;
    bottom: 0.85rem;
    height: 5rem;
    background: radial-gradient(
      ellipse at center,
      rgb(255 255 255 / var(--cf-floor)),
      rgb(201 162 39 / 0.05) 38%,
      transparent 70%
    );
    filter: blur(22px);
    pointer-events: none;
    z-index: 0;
  }

  .coverflow__card {
    --x: 0px;
    --z: 0px;
    --ry: 0deg;
    --s: 1;
    --b: 1;
    --frame: var(--color-silver);
    --px: 0px;
    --py: 0px;
    position: absolute;
    left: 50%;
    top: 1.35rem;
    width: var(--cf-card-w);
    height: var(--cf-card-h);
    margin-left: calc(var(--cf-card-w) / -2);
    transform: translate3d(var(--x), 0, var(--z)) rotateY(var(--ry)) scale(var(--s));
    transform-style: preserve-3d;
    transform-origin: var(--cf-origin);
    transition:
      transform var(--cf-duration) cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow var(--cf-duration) cubic-bezier(0.22, 1, 0.36, 1);
    background: #070707;
    overflow: visible;
    will-change: transform;
    border-radius: 0.5rem;
    box-shadow: 0 22px 38px rgb(0 0 0 / 0.4);
  }

  .coverflow__card::before {
    content: '';
    position: absolute;
    left: 12%;
    right: 12%;
    bottom: -1.2rem;
    height: 1.4rem;
    border-radius: 50%;
    background: rgb(0 0 0 / 0.52);
    filter: blur(16px);
    pointer-events: none;
    z-index: -1;
  }

  .coverflow__card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 6;
    pointer-events: none;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px var(--frame);
  }

  .coverflow__card[data-pos='0'] {
    --x: var(--cf-c2-x);
    --z: var(--cf-c2-z);
    --ry: var(--cf-c2-ry);
    --s: var(--cf-c2-s);
    --b: var(--cf-c2-b);
    --frame: var(--color-gold);
    box-shadow: 0 36px 60px rgb(0 0 0 / 0.52);
    z-index: 8;
  }

  .coverflow__card[data-pos='0']::before {
    left: 8%;
    right: 8%;
    bottom: -1.4rem;
    height: 1.65rem;
    background: rgb(0 0 0 / 0.62);
    filter: blur(18px);
  }

  .coverflow__card[data-pos='-1'] {
    --x: var(--cf-c1-x);
    --z: var(--cf-c1-z);
    --ry: var(--cf-c1-ry);
    --s: var(--cf-c1-s);
    --b: var(--cf-c1-b);
    z-index: 5;
  }

  .coverflow__card[data-pos='1'] {
    --x: var(--cf-c3-x);
    --z: var(--cf-c3-z);
    --ry: var(--cf-c3-ry);
    --s: var(--cf-c3-s);
    --b: var(--cf-c3-b);
    z-index: 5;
  }

  .coverflow__card[data-pos='-2'] {
    --x: calc(var(--cf-c1-x) * 2);
    --z: var(--cf-c4-z);
    --ry: var(--cf-c1-ry);
    --s: var(--cf-c4-s);
    --b: var(--cf-c4-b);
    z-index: 2;
  }

  .coverflow__card[data-pos='2'] {
    --x: var(--cf-c4-x);
    --z: var(--cf-c4-z);
    --ry: var(--cf-c4-ry);
    --s: var(--cf-c4-s);
    --b: var(--cf-c4-b);
    z-index: 2;
  }

  .coverflow__card[data-pos='-1']:hover:not(.is-active),
  .coverflow__card[data-pos='1']:hover:not(.is-active) {
    --s: var(--cf-scale-hover);
    --b: var(--cf-bright-hover);
    --frame: var(--color-silver-bright);
  }

  .coverflow__card a {
    position: relative;
    display: block;
    height: 100%;
    overflow: hidden;
    border-radius: inherit;
    background: #070707;
    filter: brightness(var(--b));
    transition: filter var(--cf-duration) cubic-bezier(0.22, 1, 0.36, 1);
    touch-action: pan-y;
    -webkit-user-drag: none;
    user-select: none;
  }

  .coverflow__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.08) translate3d(var(--px), var(--py), 0);
    transition: transform 420ms ease;
    -webkit-user-drag: none;
    user-select: none;
    pointer-events: none;
  }

  .coverflow__card.is-active .coverflow__photo {
    filter: saturate(1.06) contrast(1.05);
  }

  .coverflow__shade {
    position: absolute;
    inset: auto 0 0;
    height: 58%;
    background: linear-gradient(180deg, transparent, rgb(0 0 0 / 0.92));
    pointer-events: none;
  }

  .coverflow__body {
    position: absolute;
    left: 1.15rem;
    right: 1.15rem;
    bottom: 1.15rem;
    z-index: 1;
  }

  .coverflow__num {
    display: block;
    font-size: 0.92rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 0.45rem;
  }

  .coverflow__body h3 {
    font-size: 1.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.65rem;
    transition: font-size 780ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .coverflow__card.is-active .coverflow__body h3 {
    font-size: 2.25rem;
  }

  .coverflow__link {
    font-size: 0.88rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-gold);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .coverflow__badge {
    position: absolute;
    left: 0.85rem;
    top: 50%;
    z-index: 12;
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background: #0a0a0a;
    border: 1px solid rgb(200 200 200 / 0.28);
    color: var(--color-silver);
    transform: translate(-50%, -50%) translateZ(36px) rotateY(calc(var(--ry) * -1));
    transition:
      transform var(--cf-duration) cubic-bezier(0.22, 1, 0.36, 1),
      left var(--cf-duration) cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow var(--cf-duration) ease,
      border-color var(--cf-duration) ease,
      color var(--cf-duration) ease;
    box-shadow: 0 10px 24px rgb(0 0 0 / 0.42);
    pointer-events: none;
  }

  .coverflow__badge :global(svg) {
    width: 2.2rem;
    height: 2.2rem;
  }

  .coverflow__card.is-active .coverflow__badge {
    left: 3.2rem;
    transform: translate(-50%, -50%) translateZ(110px) rotateY(calc(var(--ry) * -1));
    border-color: var(--color-gold-bright);
    color: var(--color-gold-bright);
    box-shadow:
      0 0 0 1px rgb(232 197 71 / 0.35),
      0 0 14px rgb(201 162 39 / 0.5),
      0 0 32px rgb(201 162 39 / 0.28),
      0 10px 24px rgb(0 0 0 / 0.42);
  }

  .coverflow__card[data-pos='-1'] .coverflow__badge {
    opacity: 0;
  }

  .coverflow__nav {
    position: absolute;
    top: 46%;
    z-index: 14;
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    padding: 0;
    border-radius: 50%;
    border: 1px solid rgb(200 200 200 / 0.28);
    color: var(--color-gold);
    background: rgb(8 8 8 / 0.92);
  }

  .coverflow__nav svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .coverflow__nav--prev {
    left: -0.35rem;
  }

  .coverflow__nav--next {
    right: -0.35rem;
  }

  .coverflow__nav:hover {
    border-color: var(--color-gold);
    color: var(--color-gold-bright);
  }

  .coverflow__pager {
    position: relative;
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    width: max-content;
    margin: 1.7rem auto 0;
  }

  .coverflow__pager button {
    width: 1.85rem;
    height: 2px;
    background: rgb(200 200 200 / 0.22);
  }

  .coverflow__pager-bar {
    position: absolute;
    top: 0;
    left: 0;
    width: 1.85rem;
    height: 2px;
    background: var(--color-gold);
    transform: translateX(calc(var(--active, 0) * 2.35rem));
    transition: transform 780ms cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
  }

  .coverflow__hint {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    text-align: center;
    margin-top: 0.95rem;
    font-size: 0.85rem;
    color: var(--color-silver);
  }

  .coverflow__hint svg {
    flex-shrink: 0;
    color: var(--color-silver-dim);
  }

  .coverflow__hint strong {
    color: var(--color-gold);
    font-weight: 500;
  }

  .coverflow__hint-copy--tablet {
    display: none;
  }

  .vitrina-m {
    display: none;
  }

  .vitrina-m__tile {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 0.5rem;
    background: #070707;
    isolation: isolate;
    min-height: 15.5rem;
    box-shadow:
      inset 0 0 0 1px rgb(200 200 200 / 0.28),
      0 18px 40px rgb(0 0 0 / 0.45);
  }

  .vitrina-m__tile img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 720ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .vitrina-m__tile--relojes img {
    object-position: 58% 42%;
  }

  .vitrina-m__tile--pulseras img,
  .vitrina-m__tile--billeteras img {
    object-position: 50% 40%;
  }

  .vitrina-m__tile--cuidado-personal img {
    object-position: 50% 58%;
  }

  .vitrina-m__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 38%, rgb(0 0 0 / 0.88));
    pointer-events: none;
  }

  .vitrina-m__meta {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    padding: 1.15rem 1.1rem 1.05rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.28rem;
  }

  .vitrina-m__name {
    font-family: var(--font-display);
    font-size: 1.85rem;
    font-weight: 500;
    line-height: 1.1;
    color: var(--color-white);
  }

  .vitrina-m__go {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-gold);
  }

  .vitrina-m__tile:active {
    transform: scale(0.985);
  }

  .vitrina-m__tile:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .vitrina-m__tile:hover img,
    .vitrina-m__tile:focus-visible img {
      transform: scale(1.05);
    }
  }

  .cf-tuner {
    position: fixed;
    top: 5.5rem;
    right: 1rem;
    z-index: 80;
    box-sizing: border-box;
    width: 18.75rem;
    max-width: 18.75rem;
    max-height: calc(100dvh - 6.5rem);
    overflow-x: hidden;
    overflow-y: auto;
    scrollbar-gutter: stable;
    padding: 0.85rem 0.9rem 0.95rem;
    border: 1px solid rgb(201 162 39 / 0.28);
    background: rgb(10 10 10 / 0.94);
    color: var(--color-silver);
    box-shadow: 0 18px 40px rgb(0 0 0 / 0.45);
  }

  .cf-tuner[hidden] {
    display: none;
  }

  .cf-tuner__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .cf-tuner__head p {
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-gold);
  }

  .cf-tuner__head button,
  .cf-tuner__actions button {
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-gold);
    border: 1px solid rgb(201 162 39 / 0.35);
    padding: 0.28rem 0.5rem;
  }

  .cf-tuner__head button:hover,
  .cf-tuner__actions button:hover {
    border-color: var(--color-gold);
    color: var(--color-gold-bright);
  }

  .cf-tuner.is-min .cf-tuner__body,
  .cf-tuner.is-min .cf-tuner__actions {
    display: none;
  }

  .cf-tuner :global(.cf-tuner__group) {
    margin-bottom: 0.85rem;
  }

  .cf-tuner :global(.cf-tuner__group) > p {
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-silver-dim);
    margin-bottom: 0.45rem;
  }

  .cf-tuner :global(.cf-tuner__field) {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.28rem;
    margin-bottom: 0.7rem;
    font-size: 0.72rem;
  }

  .cf-tuner :global(.cf-tuner__meta) {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
  }

  .cf-tuner :global(.cf-tuner__name) {
    min-width: 0;
  }

  .cf-tuner :global(.cf-tuner__value) {
    flex: 0 0 auto;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--color-gold-bright);
  }

  .cf-tuner :global(.cf-tuner__range) {
    display: block;
    width: 100%;
    margin: 0;
    accent-color: var(--color-gold);
  }

  .cf-tuner :global(select) {
    display: block;
    width: 100%;
    font: inherit;
    color: var(--color-white);
    background: #111;
    border: 1px solid rgb(200 200 200 / 0.2);
    padding: 0.3rem 0.4rem;
  }

  .cf-tuner__actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.4rem;
    margin-top: 0.35rem;
  }

  @media (max-width: 1023px) {
    .cf-tuner {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .cf-tuner {
      left: 0.75rem;
      right: 0.75rem;
      top: auto;
      bottom: 0.75rem;
      width: auto;
      max-width: none;
      max-height: 42vh;
    }
  }

  /* --- Featured spotlight --- */
  .featured {
    background: linear-gradient(180deg, transparent, rgb(20 20 20 / 0.55), transparent);
  }

  .spotlight {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr) minmax(16rem, 0.95fr);
    gap: clamp(1.5rem, 3.5vw, 2.75rem);
    align-items: center;
    margin-top: var(--space-lg);
    margin-bottom: var(--space-xl);
  }

  .spotlight--no-specs {
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
  }

  .spotlight__media {
    display: block;
    aspect-ratio: 4 / 3;
    width: 100%;
    max-width: none;
    overflow: hidden;
    border: 1px solid rgb(201 162 39 / 0.16);
    background: var(--color-black-elevated);
  }

  .spotlight__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .spotlight__media:hover img {
    transform: scale(1.04);
  }

  .spotlight__brand {
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 0.55rem;
  }

  .spotlight__title {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 0.35rem;
  }

  .spotlight__title a:hover {
    color: var(--color-gold-bright);
  }

  .spotlight__code {
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-silver-dim);
    margin-bottom: 1rem;
  }

  .spotlight__desc {
    color: var(--color-silver);
    max-width: 38ch;
    margin-bottom: 1.25rem;
  }

  .spotlight__body .price__current {
    font-size: 2.35rem;
  }

  .spotlight__body .price__original {
    font-size: 1.15rem;
  }

  .spotlight__body .price__discount {
    font-size: 0.8rem;
    padding: 0.28rem 0.55rem;
  }

  .spotlight__link {
    margin-top: 1.25rem;
    gap: 0.85rem;
  }

  .spotlight__link-arrow {
    font-size: 1.35em;
    line-height: 1;
  }

  .spotlight__specs {
    display: grid;
    gap: 1.65rem;
    align-content: start;
    padding-left: 1.5rem;
    border-left: 1px solid rgb(200 200 200 / 0.2);
  }

  .spotlight__specs li {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .spotlight__spec-icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    flex-shrink: 0;
    color: #c9a227;
    margin-top: 0;
  }

  .spotlight__spec-icon svg {
    width: 2.25rem;
    height: 2.25rem;
    stroke: #c9a227;
  }

  .spotlight__specs strong {
    display: block;
    font-family: var(--font-body);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-white);
    margin-bottom: 0.25rem;
  }

  .spotlight__specs span {
    display: block;
    font-size: 1rem;
    color: var(--color-silver-dim);
  }

  .carousel {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.85rem;
    margin-top: 0.5rem;
  }

  .carousel__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 2rem) / 3);
    gap: 1rem;
    overflow-x: auto;
    scrollbar-width: none;
    padding-block: 0.25rem;
    touch-action: pan-y;
    cursor: grab;
    user-select: none;
    overscroll-behavior-x: contain;
  }

  .carousel__track.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
  }

  .carousel__track::-webkit-scrollbar {
    display: none;
  }

  .carousel__track :global(img) {
    -webkit-user-drag: none;
    pointer-events: none;
  }

  .carousel__slide {
    min-width: 0;
  }

  .carousel__nav {
    width: 2.6rem;
    height: 2.6rem;
    border: 1px solid rgb(201 162 39 / 0.4);
    color: var(--color-gold-bright);
    font-size: 1.6rem;
    line-height: 1;
    transition:
      background var(--transition),
      color var(--transition),
      border-color var(--transition);
  }

  .carousel__nav:hover {
    background: var(--gold-gradient);
    color: var(--color-black);
    border-color: transparent;
  }

  /* --- Order close --- */
  .order {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(2rem, 5vw, 3.5rem);
    border-top: 1px solid rgb(201 162 39 / 0.14);
  }

  .order__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .order__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .order__veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgb(5 5 5 / 0.82) 0%, rgb(5 5 5 / 0.55) 48%, rgb(5 5 5 / 0.35) 100%),
      linear-gradient(180deg, rgb(5 5 5 / 0.2), rgb(5 5 5 / 0.55));
  }

  .order__inner {
    position: relative;
    max-width: 40rem;
    margin-left: max(1rem, calc((100% - var(--max-width)) / 2));
    margin-right: auto;
    text-align: left;
  }

  .order__title {
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    line-height: 1.1;
    margin-bottom: 1rem;
  }

  .order__title em {
    font-style: italic;
    color: var(--color-gold-bright);
    display: inline;
  }

  .order__lead {
    color: var(--color-silver-dim);
    max-width: 34ch;
    margin-bottom: 1.75rem;
  }

  .order__inner :global(.order__cta) {
    white-space: nowrap;
    min-width: 15.5rem;
    padding-inline: 2rem;
  }

  /* --- Motion (motivated: hierarchy + storytelling) --- */
  @media (prefers-reduced-motion: no-preference) {
    .hero__eyebrow,
    .hero__name,
    .hero__lead,
    .hero__actions {
      animation: fade-up 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .hero__name {
      animation-delay: 0.1s;
    }

    .hero__lead {
      animation-delay: 0.2s;
    }

    .hero__cta {
      animation-delay: 0.3s;
    }

    .marks__track {
      animation: marquee 28s linear infinite;
    }

    .coverflow,
    .spotlight,
    .order__inner {
      animation: fade-up 0.85s cubic-bezier(0.22, 1, 0.36, 1) both;
      animation-timeline: view();
      animation-range: entry 8% cover 28%;
    }
  }

  @keyframes marquee {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  /* --- Breakpoints --- */
  @media (max-width: 1023px) and (min-width: 700px) {
    .coverflow {
      --cf-perspective: none;
      --cf-scene-rx: 0deg;
      --cf-card-w: min(22rem, 52vw);
      --cf-card-h: min(31.5rem, 74vw);
      --cf-c1-x: -42%;
      --cf-c1-z: 0px;
      --cf-c1-ry: 0deg;
      --cf-c1-s: 0.82;
      --cf-c1-b: 0.7;
      --cf-c2-x: 0px;
      --cf-c2-z: 0px;
      --cf-c2-ry: 0deg;
      --cf-c2-s: 1;
      --cf-c2-b: 1;
      --cf-c3-x: 42%;
      --cf-c3-z: 0px;
      --cf-c3-ry: 0deg;
      --cf-c3-s: 0.82;
      --cf-c3-b: 0.7;
      --cf-c4-x: 80%;
      --cf-c4-z: 0px;
      --cf-c4-ry: 0deg;
      --cf-c4-s: 0.7;
      --cf-c4-b: 0.5;
      --cf-scale-hover: 0.82;
      --cf-bright-hover: 0.7;
    }

    .coverflow__stage {
      perspective: none;
      height: calc(var(--cf-card-h) + 2.75rem);
    }

    .coverflow__card[data-pos='-2'],
    .coverflow__card[data-pos='2'] {
      opacity: 0;
      pointer-events: none;
    }

    .coverflow__badge {
      display: none;
    }

    .coverflow__nav {
      width: 3rem;
      height: 3rem;
    }

    .coverflow__hint-copy--desktop {
      display: none;
    }

    .coverflow__hint-copy--tablet {
      display: inline;
    }
  }

  @media (max-width: 699px) {
    .coverflow,
    .coverflow__pager,
    .coverflow__hint {
      display: none;
    }

    .collections {
      --cf-bg-x: 50%;
      --cf-bg-y: 50%;
      background-image:
        linear-gradient(180deg, rgb(5 5 5 / 0.5) 0%, rgb(5 5 5 / 0.22) 38%, rgb(5 5 5 / 0.58) 100%),
        url('/collections-bg.png');
      background-position: center, center;
