  @media (max-width: 400px) {
    .vitrina-m {
      grid-template-columns: 1fr;
    }

    .vitrina-m__tile--relojes {
      min-height: min(68vw, 22rem);
    }

    .vitrina-m__tile--pulseras,
    .vitrina-m__tile--billeteras,
    .vitrina-m__tile--cuidado-personal {
