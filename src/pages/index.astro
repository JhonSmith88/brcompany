  }

  @media (max-width: 640px) {
    .hero {
      min-height: min(62dvh, 28rem);
    }

    .hero__content {
      margin-left: 1rem;
      max-width: none;
    }

    .benefits__grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .benefits__item {
      padding-inline: 0;
    }

    .benefits__item:not(:last-child) {
      border-right: none;
      border-bottom: 1px solid rgb(200 200 200 / 0.12);
      padding-bottom: 1rem;
    }

    .spotlight {
      grid-template-columns: 1fr;
    }

    .spotlight__media {
      max-width: none;
    }

    .spotlight__specs {
      grid-template-columns: 1fr;
    }

    .carousel__track {
      grid-auto-columns: 80%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__slide {
      transition: none;
    }
  }
</style>

<script>
  function initHero(root: HTMLElement) {
    const slides = [...root.querySelectorAll<HTMLElement>('[data-hero-slide]')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-hero-dot]')];
    if (slides.length < 2) return;

    let index = 0;
    let timer: number | undefined;

    const show = (next: number) => {
      index = (next + slides.length) % slides.length;
      slides.forEach((slide, i) => slide.classList.toggle('is-active', i === index));
      dots.forEach((dot, i) => dot.classList.toggle('is-active', i === index));
    };

    const play = () => {
      window.clearInterval(timer);
      timer = window.setInterval(() => show(index + 1), 5000);
    };

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        show(Number(dot.dataset.index || 0));
        play();
      });
    });

    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      play();
    }
  }

  document.querySelectorAll<HTMLElement>('[data-hero]').forEach(initHero);

  function initCarousel(root: HTMLElement) {
    const track = root.querySelector<HTMLElement>('[data-carousel-track]');
    const prev = root.querySelector<HTMLButtonElement>('[data-carousel-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-carousel-next]');
    if (!track || !prev || !next) return;

    const originals = [...track.querySelectorAll<HTMLElement>('.carousel__slide')];
    if (originals.length === 0) return;

    if (track.dataset.ready === 'true') return;
    track.dataset.ready = 'true';

    const cloneSet = () =>
      originals.map((slide) => {
        const clone = slide.cloneNode(true) as HTMLElement;
        clone.setAttribute('aria-hidden', 'true');
        return clone;
      });

    track.prepend(...cloneSet());
    track.append(...cloneSet());

    let busy = false;
    let coasting = false;
    let coastRaf = 0;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const getStep = () => {
      const slide = track.querySelector<HTMLElement>('.carousel__slide');
      if (!slide) return 0;
      const styles = getComputedStyle(track);
      const gap = parseFloat(styles.columnGap || styles.gap) || 16;
      return slide.getBoundingClientRect().width + gap;
    };

    const setWidth = () => getStep() * originals.length;

    const normalize = () => {
      const width = setWidth();
      if (width <= 0) return;
      const left = track.scrollLeft;
      if (left < width * 0.5) track.scrollLeft = left + width;
      else if (left >= width * 1.5) track.scrollLeft = left - width;
    };

    const stopCoast = () => {
      if (coastRaf) cancelAnimationFrame(coastRaf);
      coastRaf = 0;
      coasting = false;
    };

    const snapToNearest = () => {
      const step = getStep();
      if (!step) {
        normalize();
        return;
      }
      const nearest = Math.round(track.scrollLeft / step) * step;
      if (Math.abs(nearest - track.scrollLeft) < 1) {
        normalize();
        return;
      }
      busy = true;
      track.scrollTo({ left: nearest, behavior: reduceMotion ? 'auto' : 'smooth' });
      window.setTimeout(() => {
        normalize();
        busy = false;
      }, reduceMotion ? 0 : 420);
    };

    const start = () => {
      const width = setWidth();
      if (width <= 0) {
        requestAnimationFrame(start);
        return;
      }
      track.scrollLeft = width;
    };

    const move = (dir: number) => {
      const step = getStep();
      if (!step || busy) return;
      stopCoast();
      busy = true;
      track.scrollBy({ left: dir * step, behavior: 'smooth' });
      window.setTimeout(() => {
        normalize();
        busy = false;
      }, 450);
    };

    prev.addEventListener('click', () => move(-1));
    next.addEventListener('click', () => move(1));

    let pointerId: number | null = null;
    let startX = 0;
    let startY = 0;
    let startScroll = 0;
    let lastX = 0;
    let lastT = 0;
    let velocity = 0;
    let dragging = false;
    let locked = false;
    let swiped = false;

    const coast = (initial: number) => {
      let v = Math.max(-2.4, Math.min(2.4, initial));
      if (reduceMotion || Math.abs(v) < 0.12) {
        snapToNearest();
        return;
      }
      coasting = true;
      let prevT = performance.now();
      const tick = (now: number) => {
        const dt = Math.min(32, now - prevT);
        prevT = now;
        track.scrollLeft += v * dt;
        normalize();
        v *= Math.pow(0.952, dt / 16.67);
        if (Math.abs(v) < 0.05) {
          coastRaf = 0;
          coasting = false;
          snapToNearest();
          return;
        }
        coastRaf = requestAnimationFrame(tick);
      };
      coastRaf = requestAnimationFrame(tick);
    };

    const endDrag = (event: PointerEvent) => {
      if (!dragging && !locked) return;
      const wasLocked = locked;
      dragging = false;
      locked = false;
      pointerId = null;
      track.classList.remove('is-dragging');
      if (wasLocked && event.type === 'pointerup') {
        if (performance.now() - lastT > 64) velocity = 0;
        coast(velocity);
      } else {
        normalize();
      }
    };

    track.addEventListener('pointerdown', (event) => {
      if (event.button !== 0) return;
      const target = event.target as HTMLElement | null;
      if (target?.closest('[data-carousel-prev], [data-carousel-next], [data-add-to-cart], button')) return;
      pointerId = event.pointerId;
      startX = event.clientX;
      startY = event.clientY;
      startScroll = track.scrollLeft;
      lastX = event.clientX;
      lastT = performance.now();
      velocity = 0;
      dragging = true;
      locked = false;
      swiped = false;
      stopCoast();
    });

    track.addEventListener('dragstart', (event) => {
      event.preventDefault();
    });

    track.addEventListener('pointermove', (event) => {
      if (!dragging || event.pointerId !== pointerId) return;
      const dx = event.clientX - startX;
      const dy = event.clientY - startY;
      if (!locked) {
        if (Math.abs(dx) < 8 && Math.abs(dy) < 8) return;
        if (Math.abs(dy) >= Math.abs(dx)) {
          dragging = false;
          pointerId = null;
          return;
        }
        locked = true;
        swiped = true;
        track.classList.add('is-dragging');
        try {
          track.setPointerCapture(event.pointerId);
        } catch {
          /* capture is optional */
        }
      }
      const now = performance.now();
      const dt = Math.max(1, now - lastT);
      const inst = -(event.clientX - lastX) / dt;
      velocity = velocity * 0.65 + inst * 0.35;
      lastX = event.clientX;
      lastT = now;
      track.scrollLeft = startScroll - dx;
    });

    track.addEventListener('pointerup', endDrag);
    track.addEventListener('pointercancel', endDrag);

    track.addEventListener(
      'click',
      (event) => {
        if (!swiped) return;
        event.preventDefault();
        event.stopPropagation();
        swiped = false;
      },
      true,
    );

    let scrollTimer: number | undefined;
    track.addEventListener(
      'scroll',
      () => {
        if (locked || busy || coasting) return;
        window.clearTimeout(scrollTimer);
        scrollTimer = window.setTimeout(normalize, 80);
      },
      { passive: true },
    );

    requestAnimationFrame(start);
  }

  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach(initCarousel);

  function initCoverflow(root: HTMLElement) {
    const host = root.closest('.collections') ?? root.parentElement ?? root;
    const cards = [...root.querySelectorAll<HTMLElement>('[data-coverflow-card]')];
    const pager = host.querySelector<HTMLElement>('[data-coverflow-pager]');
    const dots = [...host.querySelectorAll<HTMLButtonElement>('[data-coverflow-dot]')];
    const prev = root.querySelector<HTMLButtonElement>('[data-coverflow-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-coverflow-next]');
    if (cards.length === 0) return;

    const count = cards.length;
    let active = cards.findIndex((card) => card.classList.contains('is-active'));
    if (active < 0) active = Math.min(1, count - 1);

    const wrapOffset = (offset: number) => {
      offset = ((offset % count) + count) % count;
      if (offset > count - 2) offset -= count;
      return offset;
    };

    const layout = () => {
      cards.forEach((card, index) => {
        const offset = wrapOffset(index - active);
        card.dataset.pos = String(offset);
        card.classList.toggle('is-active', index === active);
        if (index !== active) {
          card.style.setProperty('--px', '0px');
          card.style.setProperty('--py', '0px');
        }
      });
      dots.forEach((dot, index) => dot.classList.toggle('is-active', index === active));
      pager?.style.setProperty('--active', String(active));
    };

    const goTo = (index: number) => {
      active = ((index % count) + count) % count;
      layout();
    };

    prev?.addEventListener('click', () => goTo(active + 1));
    next?.addEventListener('click', () => goTo(active - 1));
    dots.forEach((dot) => {
      dot.addEventListener('click', () => goTo(Number(dot.dataset.index || 0)));
    });

    const stage = root.querySelector<HTMLElement>('.coverflow__stage');
    let startX = 0;
    let dragging = false;
    let locked = false;
    let swiped = false;
    let pointerId: number | null = null;
    const SWIPE_THRESHOLD = 42;
    const LOCK_THRESHOLD = 10;

    const endDrag = (event: PointerEvent) => {
      if (!dragging || (pointerId !== null && event.pointerId !== pointerId)) return;
      const delta = event.clientX - startX;
      const wasLocked = locked;
      dragging = false;
      locked = false;
      pointerId = null;
      stage?.classList.remove('is-dragging');
      if (wasLocked && Math.abs(delta) >= SWIPE_THRESHOLD) {
        swiped = true;
        goTo(active + (delta < 0 ? 1 : -1));
      }
    };

    root.addEventListener('pointerdown', (event) => {
      if (event.button !== 0) return;
      const target = event.target as HTMLElement | null;
      if (target?.closest('[data-coverflow-prev], [data-coverflow-next], [data-coverflow-dot], button')) return;
      dragging = true;
      locked = false;
      swiped = false;
      pointerId = event.pointerId;
      startX = event.clientX;
    });

    root.addEventListener('pointermove', (event) => {
      if (!dragging || event.pointerId !== pointerId) return;
      const dx = event.clientX - startX;
      if (locked || Math.abs(dx) < LOCK_THRESHOLD) return;
      locked = true;
      swiped = true;
      stage?.classList.add('is-dragging');
      try {
        root.setPointerCapture(event.pointerId);
      } catch {
        /* capture is optional */
      }
    });

    root.addEventListener('pointerup', endDrag);
    root.addEventListener('pointercancel', (event) => {
      if (pointerId !== null && event.pointerId !== pointerId) return;
      dragging = false;
      locked = false;
      pointerId = null;
      stage?.classList.remove('is-dragging');
    });

    root.addEventListener(
      'click',
      (event) => {
        if (!swiped) return;
        event.preventDefault();
        event.stopPropagation();
        swiped = false;
      },
      true,
    );

    cards.forEach((card, index) => {
      const link = card.querySelector('a');
      link?.addEventListener('click', (event) => {
        if (swiped) {
          event.preventDefault();
          return;
        }
        if (index !== active) {
          event.preventDefault();
          goTo(index);
        }
      });

      card.addEventListener('pointermove', (event) => {
        if (index !== active || dragging || swiped) return;
        const rect = card.getBoundingClientRect();
        const px = ((event.clientX - rect.left) / rect.width - 0.5) * -14;
        const py = ((event.clientY - rect.top) / rect.height - 0.5) * -10;
        card.style.setProperty('--px', `${px}px`);
        card.style.setProperty('--py', `${py}px`);
      });

      card.addEventListener('pointerleave', () => {
        card.style.setProperty('--px', '0px');
        card.style.setProperty('--py', '0px');
      });
    });

    layout();
    root.dataset.cfReady = 'true';
  }

  const coverflowMq = window.matchMedia('(min-width: 700px)');

  const syncCoverflow = () => {
    if (!coverflowMq.matches) return;
    document.querySelectorAll<HTMLElement>('[data-coverflow]').forEach((root) => {
      if (root.dataset.cfReady) return;
      initCoverflow(root);
    });
  };

  coverflowMq.addEventListener('change', syncCoverflow);
  syncCoverflow();

  function initCoverflowTuner() {
    const params = new URLSearchParams(window.location.search);
    const enabled = params.has('debug') || params.has('vitrina');
    const panel = document.querySelector<HTMLElement>('[data-cf-tuner]');
    const root = document.querySelector<HTMLElement>('[data-coverflow]');
    if (!enabled || !panel || !root) return;

    type Field = {
      key: string;
      label: string;
      group: string;
      min?: number;
      max?: number;
      step?: number;
      unit?: string;
      def: string;
      options?: [string, string][];
    };

    const cardFields = (
      n: number,
      group: string,
      defs: { x: string; z: string; ry: string; s: string; b: string },
    ): Field[] => [
      { key: `--cf-c${n}-x`, label: 'X', group, min: -50, max: 50, step: 0.1, unit: 'rem', def: defs.x },
      { key: `--cf-c${n}-z`, label: 'Z', group, min: -160, max: 140, step: 2, unit: 'px', def: defs.z },
      { key: `--cf-c${n}-ry`, label: 'Rotación Y', group, min: -25, max: 25, step: 0.5, unit: 'deg', def: defs.ry },
      { key: `--cf-c${n}-s`, label: 'Escala', group, min: 0.75, max: 1.2, step: 0.01, unit: '', def: defs.s },
      { key: `--cf-c${n}-b`, label: 'Brillo', group, min: 0.3, max: 1, step: 0.01, unit: '', def: defs.b },
    ];

    const fields: Field[] = [
      { key: '--cf-perspective', label: 'Perspectiva', group: 'Cámara', min: 700, max: 2200, step: 20, unit: 'px', def: '1800px' },
      { key: '--cf-origin-y', label: 'Origen Y', group: 'Cámara', min: 20, max: 80, step: 1, unit: '%', def: '40%' },
      { key: '--cf-scene-rx', label: 'Inclinación escena', group: 'Cámara', min: 0, max: 18, step: 0.5, unit: 'deg', def: '0deg' },
      { key: '--cf-card-w', label: 'Ancho', group: 'Medidas', min: 12, max: 26, step: 0.05, unit: 'rem', def: '22.6rem' },
      { key: '--cf-card-h', label: 'Alto', group: 'Medidas', min: 18, max: 36, step: 0.05, unit: 'rem', def: '32.5rem' },
      { key: '--cf-origin', label: 'Pivote', group: 'Medidas', def: '50% 50%', options: [['50% 50%', 'Centro'], ['50% 100%', 'Suelo']] },
      ...cardFields(1, 'Card 1 · izquierda', { x: '-34.2rem', z: '-4px', ry: '-23.5deg', s: '0.96', b: '0.75' }),
      ...cardFields(2, 'Card 2 · activa', { x: '-12.4rem', z: '48px', ry: '-11.5deg', s: '1.05', b: '0.76' }),
      ...cardFields(3, 'Card 3', { x: '10.3rem', z: '94px', ry: '18deg', s: '0.94', b: '0.76' }),
      ...cardFields(4, 'Card 4 · derecha', { x: '30.4rem', z: '68px', ry: '10deg', s: '0.9', b: '0.58' }),
      { key: '--cf-bg-x', label: 'Fondo X', group: 'Fondo', min: 0, max: 100, step: 1, unit: '%', def: '37%' },
      { key: '--cf-bg-y', label: 'Fondo Y', group: 'Fondo', min: 0, max: 100, step: 1, unit: '%', def: '80%' },
      { key: '--cf-bg-size', label: 'Tamaño fondo', group: 'Fondo', min: 60, max: 260, step: 1, unit: '%', def: '100%' },
      { key: '--cf-duration', label: 'Duración', group: 'Movimiento', min: 400, max: 1000, step: 20, unit: 'ms', def: '720ms' },
      { key: '--cf-floor', label: 'Suelo', group: 'Movimiento', min: 0, max: 0.25, step: 0.01, unit: '', def: '0.12' },
    ];

    const storageKey = 'rbcompany-coverflow-3d-v2';
    const form = panel.querySelector<HTMLFormElement>('[data-cf-form]');
    const copyBtn = panel.querySelector<HTMLButtonElement>('[data-cf-copy]');
    const resetBtn = panel.querySelector<HTMLButtonElement>('[data-cf-reset]');
    const collapseBtn = panel.querySelector<HTMLButtonElement>('[data-cf-collapse]');
    if (!form || !copyBtn || !resetBtn || !collapseBtn) return;

    const defaults = Object.fromEntries(fields.map((field) => [field.key, field.def]));
    const parseNumber = (value: string) => Number.parseFloat(value);

    const load = () => {
      try {
        const raw = window.localStorage.getItem(storageKey);
        return raw ? { ...defaults, ...JSON.parse(raw) } : { ...defaults };
      } catch {
        return { ...defaults };
      }
    };

    let values = load();

    const scene = root.closest<HTMLElement>('.collections') ?? root;
    const desktopMq = window.matchMedia('(min-width: 1024px)');

    const apply = () => {
      if (!desktopMq.matches) {
        Object.keys(values).forEach((key) => {
          const target = key.startsWith('--cf-bg-') ? scene : root;
          target.style.removeProperty(key);
        });
        return;
      }
      Object.entries(values).forEach(([key, value]) => {
        const target = key.startsWith('--cf-bg-') ? scene : root;
        target.style.setProperty(key, value);
      });
    };

    desktopMq.addEventListener('change', apply);

    const persist = () => {
      window.localStorage.setItem(storageKey, JSON.stringify(values));
    };

    const format = (field: Field, raw: number) =>
      field.unit ? `${raw}${field.unit}` : String(raw);

    const groups = [...new Set(fields.map((field) => field.group))];
    groups.forEach((group) => {
      const wrap = document.createElement('div');
      wrap.className = 'cf-tuner__group';
      wrap.innerHTML = `<p>${group}</p>`;
      fields
        .filter((field) => field.group === group)
        .forEach((field) => {
          const label = document.createElement('label');
          label.className = 'cf-tuner__field';
          if (field.options) {
            const select = document.createElement('select');
            select.name = field.key;
            field.options.forEach(([value, text]) => {
              const option = document.createElement('option');
              option.value = value;
              option.textContent = text;
              select.append(option);
            });
            select.value = values[field.key];
            select.addEventListener('change', () => {
              values[field.key] = select.value;
              apply();
              persist();
            });
            label.innerHTML = `<span class="cf-tuner__meta"><span class="cf-tuner__name">${field.label}</span></span>`;
            label.append(select);
          } else {
            const current = parseNumber(values[field.key]);
            label.innerHTML = `<span class="cf-tuner__meta"><span class="cf-tuner__name">${field.label}</span><strong class="cf-tuner__value" data-val></strong></span>`;
            const input = document.createElement('input');
            input.type = 'range';
            input.className = 'cf-tuner__range';
            input.name = field.key;
            input.min = String(field.min);
            input.max = String(field.max);
            input.step = String(field.step);
            input.value = String(current);
            const readout = label.querySelector('[data-val]');
            if (readout) readout.textContent = values[field.key];
            input.addEventListener('input', () => {
              values[field.key] = format(field, Number(input.value));
              if (readout) readout.textContent = values[field.key];
              apply();
            });
            input.addEventListener('change', persist);
            label.append(input);
          }
          wrap.append(label);
        });
      form.append(wrap);
    });

    const syncInputs = () => {
      fields.forEach((field) => {
        const control = form.elements.namedItem(field.key);
        if (control instanceof HTMLInputElement) {
          control.value = String(parseNumber(values[field.key]));
          const readout = control.parentElement?.querySelector('[data-val]');
          if (readout) readout.textContent = values[field.key];
        }
        if (control instanceof HTMLSelectElement) control.value = values[field.key];
      });
    };

    copyBtn.addEventListener('click', async () => {
      const bg = fields.filter((field) => field.key.startsWith('--cf-bg-'));
      const rest = fields.filter((field) => !field.key.startsWith('--cf-bg-'));
      const block = (selector: string, list: Field[]) =>
        `${selector} {\n${list.map((field) => `  ${field.key}: ${values[field.key]};`).join('\n')}\n}`;
      const css = `${block('.collections', bg)}\n\n${block('.coverflow', rest)}`;
      try {
        await navigator.clipboard.writeText(css);
        copyBtn.textContent = 'Copiado';
        window.setTimeout(() => {
          copyBtn.textContent = 'Copiar CSS';
        }, 1400);
      } catch {
        copyBtn.textContent = 'Error';
      }
    });

    resetBtn.addEventListener('click', () => {
      values = { ...defaults };
      window.localStorage.removeItem(storageKey);
      fields.forEach((field) => {
        const target = field.key.startsWith('--cf-bg-') ? scene : root;
        target.style.removeProperty(field.key);
      });
      syncInputs();
    });

    collapseBtn.addEventListener('click', () => {
      const minimized = panel.classList.toggle('is-min');
      collapseBtn.textContent = minimized ? '+' : '−';
      collapseBtn.setAttribute('aria-label', minimized ? 'Expandir' : 'Minimizar');
    });

    apply();
    panel.hidden = false;
  }

  initCoverflowTuner();
</script>
