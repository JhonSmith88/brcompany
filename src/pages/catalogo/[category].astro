---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCategoryBySlug, getCategories, getProductsByCategory } from '../../lib/catalog';
import { getCatalogPageCopy } from '../../lib/catalog-page';

export async function getStaticPaths() {
  const categories = await getCategories();
  return categories.map((category) => ({
    params: { category: category.slug },
  }));
}

const { category: categorySlug } = Astro.params;
const category = await getCategoryBySlug(categorySlug!);

if (!category) {
  return Astro.redirect('/catalogo');
}

const products = await getProductsByCategory(category.slug);
const catalog = await getCatalogPageCopy();
---

<BaseLayout
  title={category.nombre}
  description={category.descripcion}
  image={category.imagen || '/og.jpg'}
  imageAlt={category.nombre}
>
  <section class="banner">
    <img src={category.imagen} alt="" class="banner__img" width="1600" height="700" />
    <div class="banner__veil"></div>
    <div class="container banner__content anim-fade-up">
      <Breadcrumbs
        items={[
          { label: 'Inicio', href: '/' },
          { label: catalog.title, href: '/catalogo' },
          { label: category.nombre, href: `/catalogo/${category.slug}` },
        ]}
      />
      <p class="eyebrow">{catalog.categoryEyebrow}</p>
      <h1 class="section-title">{category.nombre}</h1>
      <hr class="divider" />
      <p class="section-lead">{category.descripcion}</p>
    </div>
  </section>

  <section class="section" data-catalog data-total={products.length}>
    <div class="container">
      {
        products.length === 0 ? (
          <p class="empty">{catalog.emptyCategory}</p>
        ) : (
          <>
            <div class="toolbar">
              <div class="toolbar__cluster toolbar__cluster--start">
                <button class="toolbar__filter" type="button" data-filter-toggle aria-expanded="false" aria-controls="catalog-filters">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                    <path d="M4 5h16l-6.2 7.4V19l-3.6 2v-8.6L4 5z" stroke-linejoin="round"></path>
                  </svg>
                  Filtrar
                </button>
                <div class="toolbar__menu" id="catalog-filters" data-filter-panel hidden>
                  <p class="toolbar__menu-label">Filtrar</p>
                  <button type="button" data-filter="all" class="is-active">Todos</button>
                  <button type="button" data-filter="stock">Disponibles</button>
                  <button type="button" data-filter="sale">En oferta</button>
                </div>
              </div>

              <p class="toolbar__count" data-count>
                Mostrando 1-{Math.min(6, products.length)} de {products.length} Productos
              </p>

              <div class="toolbar__cluster toolbar__cluster--end">
                <button
                  class="toolbar__sort"
                  type="button"
                  data-sort-toggle
                  aria-expanded="false"
                  aria-controls="catalog-sort"
                >
                  <span>Ordenar por</span>
                  <svg class="toolbar__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                </button>
                <div class="toolbar__menu toolbar__menu--end" id="catalog-sort" data-sort-panel hidden>
                  <p class="toolbar__menu-label">Orden</p>
                  <button type="button" data-sort="featured" class="is-active">Recomendados</button>
                  <button type="button" data-sort="price-asc">Precio: menor a mayor</button>
                  <button type="button" data-sort="price-desc">Precio: mayor a menor</button>
                  <button type="button" data-sort="name">Nombre A-Z</button>
                  <button type="button" data-sort="discount">Mayor descuento</button>
                </div>
              </div>
            </div>

            <div class="grid-products" data-product-grid>
              {products.map((product, index) => (
                <div
                  data-product
                  data-index={index}
                  data-price={product.precioReal}
                  data-name={product.nombre}
                  data-discount={product.descuento}
                  data-stock={product.stock}
                >
                  <ProductCard product={product} />
                </div>
              ))}
            </div>
            <nav class="pager" data-pager aria-label="Paginación">
              <button type="button" class="pager__arrow" data-pager-prev aria-label="Página anterior">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                  <path d="M15 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </button>
              <div class="pager__pages" data-pager-pages></div>
              <button type="button" class="pager__arrow" data-pager-next aria-label="Página siguiente">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                  <path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </button>
            </nav>
            <p class="empty empty--filter" data-empty-filter hidden>{catalog.emptyFilter}</p>
          </>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .banner {
    position: relative;
    min-height: 22rem;
    display: grid;
    align-items: end;
    overflow: hidden;
  }

  .banner__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .banner__veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(5, 5, 5, 0.25), rgba(5, 5, 5, 0.92));
  }

  .banner__content {
    position: relative;
    z-index: 1;
    padding-block: var(--space-xl) var(--space-lg);
  }

  .toolbar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.75rem;
    padding-bottom: 1.15rem;
    border-bottom: 1px solid rgb(201 162 39 / 0.2);
  }

  .toolbar__cluster {
    position: relative;
    justify-self: start;
  }

  .toolbar__cluster--end {
    justify-self: end;
  }

  .toolbar__filter,
  .toolbar__sort {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0;
    border: 0;
    background: none;
    font-family: var(--font-body);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .toolbar__filter {
    color: var(--color-gold-bright);
  }

  .toolbar__sort {
    color: var(--color-white);
  }

  .toolbar__filter svg,
  .toolbar__chevron {
    width: 1.05rem;
    height: 1.05rem;
    flex-shrink: 0;
  }

  .toolbar__chevron {
    color: var(--color-gold-bright);
    transition: transform 220ms ease;
  }

  .toolbar__sort[aria-expanded='true'] .toolbar__chevron {
    transform: rotate(180deg);
  }

  .toolbar__menu {
    position: absolute;
    top: calc(100% + 0.85rem);
    left: 0;
    z-index: 12;
    width: max(15.5rem, 100%);
    padding: 0.7rem 0.45rem 0.5rem;
    background:
      linear-gradient(180deg, rgb(22 22 22 / 0.98), rgb(8 8 8 / 0.98));
    border: 1px solid rgb(201 162 39 / 0.32);
    box-shadow:
      0 18px 40px rgb(0 0 0 / 0.45),
      inset 0 1px 0 rgb(232 197 71 / 0.12);
  }

  .toolbar__menu--end {
    left: auto;
    right: 0;
  }

  .toolbar__menu[hidden] {
    display: none;
  }

  .toolbar__menu::before {
    content: '';
    position: absolute;
    top: -5px;
    left: 1.15rem;
    width: 8px;
    height: 8px;
    background: #161616;
    border-top: 1px solid rgb(201 162 39 / 0.32);
    border-left: 1px solid rgb(201 162 39 / 0.32);
    transform: rotate(45deg);
  }

  .toolbar__menu--end::before {
    left: auto;
    right: 1.35rem;
  }

  .toolbar__menu-label {
    margin: 0 0.7rem 0.45rem;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-gold);
  }

  .toolbar__menu button {
    display: flex;
    align-items: center;
    width: 100%;
    padding: 0.62rem 0.85rem 0.62rem 0.7rem;
    border: 0;
    background: none;
    color: var(--color-silver);
    font-family: var(--font-body);
    font-size: 0.88rem;
    letter-spacing: 0.02em;
    text-align: left;
    cursor: pointer;
    transition:
      color var(--transition),
      background var(--transition);
  }

  .toolbar__menu button::before {
    content: '';
    width: 0.35rem;
    height: 0.35rem;
    margin-right: 0.7rem;
    border: 1px solid rgb(201 162 39 / 0.45);
    background: transparent;
    flex-shrink: 0;
  }

  .toolbar__menu button:hover {
    color: var(--color-white);
    background: rgb(201 162 39 / 0.08);
  }

  .toolbar__menu button.is-active {
    color: var(--color-gold-bright);
    background: rgb(201 162 39 / 0.12);
  }

  .toolbar__menu button.is-active::before {
    background: var(--color-gold);
    border-color: var(--color-gold);
  }

  .toolbar__count {
    justify-self: center;
    margin: 0;
    color: var(--color-silver-dim);
    font-size: 0.92rem;
    letter-spacing: 0.02em;
    text-align: center;
  }

  .grid-products {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .empty {
    color: var(--color-silver-dim);
    text-align: center;
    padding: 3rem 1rem;
  }

  .pager {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.15rem;
    margin-top: 2.75rem;
  }

  .pager[hidden] {
    display: none;
  }

  .pager__pages {
    display: flex;
    align-items: center;
    gap: 1.15rem;
  }

  .pager :global(button) {
    display: grid;
    place-items: center;
    box-sizing: border-box;
    width: 2.35rem;
    height: 2.35rem;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 0;
    background: none;
    color: var(--color-silver-dim);
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1;
    cursor: pointer;
  }

  .pager__arrow svg {
    width: 1.05rem;
    height: 1.05rem;
  }

  .pager :global(button.is-active) {
    color: var(--color-gold-bright);
    border-color: var(--color-gold);
  }

  .pager :global(button:hover:not(:disabled):not(.is-active)) {
    color: var(--color-white);
  }

  .pager :global(button:disabled) {
    opacity: 0.35;
    cursor: default;
  }

  @media (max-width: 900px) {
    .grid-products {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 720px) {
    .toolbar {
      grid-template-columns: 1fr 1fr;
      row-gap: 0.85rem;
    }

    .toolbar__count {
      grid-column: 1 / -1;
      order: 3;
    }
  }

  @media (max-width: 560px) {
    .grid-products {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-catalog]');
  if (root) {
    const grid = root.querySelector<HTMLElement>('[data-product-grid]');
    const countEl = root.querySelector<HTMLElement>('[data-count]');
    const empty = root.querySelector<HTMLElement>('[data-empty-filter]');
    const filterToggle = root.querySelector<HTMLButtonElement>('[data-filter-toggle]');
    const filterPanel = root.querySelector<HTMLElement>('[data-filter-panel]');
    const sortToggle = root.querySelector<HTMLButtonElement>('[data-sort-toggle]');
    const sortPanel = root.querySelector<HTMLElement>('[data-sort-panel]');
    const filterBtns = root.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const sortBtns = root.querySelectorAll<HTMLButtonElement>('[data-sort]');
    const pager = root.querySelector<HTMLElement>('[data-pager]');
    const pagerPages = root.querySelector<HTMLElement>('[data-pager-pages]');
    const pagerPrev = root.querySelector<HTMLButtonElement>('[data-pager-prev]');
    const pagerNext = root.querySelector<HTMLButtonElement>('[data-pager-next]');
    const PAGE_SIZE = 6;
    let filter = 'all';
    let sort = 'featured';
    let page = 1;

    const setOpen = (toggle: HTMLButtonElement | null, panel: HTMLElement | null, open: boolean) => {
      if (!toggle || !panel) return;
      panel.toggleAttribute('hidden', !open);
      toggle.setAttribute('aria-expanded', String(open));
    };

    const closeMenus = () => {
      setOpen(filterToggle, filterPanel, false);
      setOpen(sortToggle, sortPanel, false);
    };

    const apply = () => {
      if (!grid || !countEl) return;
      const items = [...grid.querySelectorAll<HTMLElement>('[data-product]')];
      const shown: HTMLElement[] = [];

      items.forEach((el) => {
        const stock = Number(el.dataset.stock);
        const discount = Number(el.dataset.discount);
        const match =
          filter === 'all' ||
          (filter === 'stock' && stock > 0) ||
          (filter === 'sale' && discount > 0);
        if (match) shown.push(el);
        else el.hidden = true;
      });

      shown.sort((a, b) => {
        if (sort === 'price-asc') return Number(a.dataset.price) - Number(b.dataset.price);
        if (sort === 'price-desc') return Number(b.dataset.price) - Number(a.dataset.price);
        if (sort === 'name') return (a.dataset.name ?? '').localeCompare(b.dataset.name ?? '', 'es');
        if (sort === 'discount') return Number(b.dataset.discount) - Number(a.dataset.discount);
        return Number(a.dataset.index) - Number(b.dataset.index);
      });

      shown.forEach((el) => grid.appendChild(el));
      items.filter((el) => !shown.includes(el)).forEach((el) => grid.appendChild(el));

      const n = shown.length;
      const pages = Math.max(1, Math.ceil(n / PAGE_SIZE));
      if (page > pages) page = pages;

      shown.forEach((el, index) => {
        const start = (page - 1) * PAGE_SIZE;
        el.hidden = index < start || index >= start + PAGE_SIZE;
      });

      const from = n === 0 ? 0 : (page - 1) * PAGE_SIZE + 1;
      const to = Math.min(page * PAGE_SIZE, n);
      countEl.textContent =
        n === 0 ? 'Mostrando 0 de 0 Productos' : `Mostrando ${from}-${to} de ${n} Productos`;
      if (empty) empty.hidden = n !== 0;
      if (pager) pager.hidden = n === 0;

      if (pagerPages) {
        pagerPages.replaceChildren();
        for (let i = 1; i <= pages; i += 1) {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.textContent = String(i);
          btn.setAttribute('aria-label', `Página ${i}`);
          if (i === page) {
            btn.classList.add('is-active');
            btn.setAttribute('aria-current', 'page');
          }
          btn.addEventListener('click', () => {
            page = i;
            apply();
          });
          pagerPages.append(btn);
        }
      }

      if (pagerPrev) pagerPrev.disabled = page <= 1 || n === 0;
      if (pagerNext) pagerNext.disabled = page >= pages || n === 0;
    };

    filterToggle?.addEventListener('click', (event) => {
      event.stopPropagation();
      const open = filterPanel?.hasAttribute('hidden') ?? false;
      setOpen(sortToggle, sortPanel, false);
      setOpen(filterToggle, filterPanel, open);
    });

    sortToggle?.addEventListener('click', (event) => {
      event.stopPropagation();
      const open = sortPanel?.hasAttribute('hidden') ?? false;
      setOpen(filterToggle, filterPanel, false);
      setOpen(sortToggle, sortPanel, open);
    });

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filter = btn.dataset.filter ?? 'all';
        filterBtns.forEach((item) => item.classList.toggle('is-active', item === btn));
        closeMenus();
        page = 1;
        apply();
      });
    });

    sortBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        sort = btn.dataset.sort ?? 'featured';
        sortBtns.forEach((item) => item.classList.toggle('is-active', item === btn));
        closeMenus();
        page = 1;
        apply();
      });
    });

    pagerPrev?.addEventListener('click', () => {
      if (page <= 1) return;
      page -= 1;
      apply();
    });

    pagerNext?.addEventListener('click', () => {
      page += 1;
      apply();
    });

    document.addEventListener('click', (event) => {
      const target = event.target as Node;
      if (filterPanel?.contains(target) || filterToggle?.contains(target)) return;
      if (sortPanel?.contains(target) || sortToggle?.contains(target)) return;
      closeMenus();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeMenus();
    });

    apply();
  }
</script>
