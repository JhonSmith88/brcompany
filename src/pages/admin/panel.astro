---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Resumen">
  <p class="admin-alert" data-admin-alert hidden></p>
  <div class="admin-grid" data-stats>
    <a class="admin-card" href="/admin/ventas?periodo=mes&status=vendido">
      <span>Ingresos del mes</span>
      <strong data-stat="revenue">—</strong>
    </a>
    <a class="admin-card" href="/admin/ventas?status=pendiente">
      <span>Pendientes</span>
      <strong data-stat="pending">—</strong>
    </a>
    <a class="admin-card" href="/admin/productos?stock=bajo">
      <span>Stock bajo</span>
      <strong data-stat="low">—</strong>
    </a>
    <a class="admin-card" href="/admin/ventas?periodo=mes&status=vendido">
      <span>Ventas del mes</span>
      <strong data-stat="month-sales">—</strong>
    </a>
  </div>
  <section class="admin-panel-block">
    <h2 class="section-title">Miniaturas</h2>
    <p class="muted">Mismo generador que Miju: canvas ~640px. Las fotos que aún usan la imagen completa aparecen aquí.</p>
    <p class="muted" data-thumb-status>Revisando…</p>
    <div class="admin-actions">
      <button type="button" class="btn btn--outline" data-backfill-thumbs hidden>Generar miniaturas faltantes</button>
    </div>
  </section>
  <section class="admin-panel-block">
    <h2 class="section-title">Stock bajo</h2>
    <p class="muted">Piezas con 3 o menos unidades. <a href="/admin/productos?stock=bajo">Ver en Productos</a></p>
    <div class="admin-history" data-low-list></div>
  </section>
  <section class="admin-panel-block">
    <h2 class="section-title">Últimas ventas</h2>
    <div class="admin-history" data-recent-sales></div>
  </section>
</AdminLayout>

<script>
  import { requireAdminSession } from '../../lib/admin';
  import { saleInPeriod, saleStatusLabel, saleTotal } from '../../lib/admin-sales';
  import { formatPrice } from '../../data/site';
  import { generateAndUploadThumb, missingThumb } from '../../lib/media/photo-wizard';
  import { escapeHtml } from '../../lib/media/ui';

  const gate = await requireAdminSession();
  if (!gate) throw new Error('redirect');
  const { supabase } = gate;
  const alertEl = document.querySelector('[data-admin-alert]');
  const lowList = document.querySelector('[data-low-list]');
  const recentList = document.querySelector('[data-recent-sales]');
  const thumbStatus = document.querySelector('[data-thumb-status]');
  const backfillBtn = document.querySelector<HTMLButtonElement>('[data-backfill-thumbs]');

  type SaleRow = {
    id: string;
    status: string;
    created_at: string;
    customers?: { name: string } | { name: string }[] | null;
    sale_items?: { qty: number; unit_price: number }[];
  };

  const [{ data: lowRows, error: productError }, { data: sales, error: salesError }] = await Promise.all([
    supabase.from('products').select('codigo, nombre, stock').lte('stock', 3).order('stock', { ascending: true }),
    supabase
      .from('sales')
      .select('id, status, created_at, customers(name), sale_items(qty, unit_price)')
      .order('created_at', { ascending: false }),
  ]);

  function customerName(row: SaleRow) {
    const related = row.customers;
    return (Array.isArray(related) ? related[0] : related)?.name ?? 'Cliente';
  }

  const rows = (sales ?? []) as SaleRow[];
  const pending = rows.filter((row) => row.status === 'pendiente').length;
  const monthSold = rows.filter((row) => row.status === 'vendido' && saleInPeriod(row.created_at, 'mes'));
  const revenue = monthSold.reduce((sum, row) => sum + saleTotal(row.sale_items ?? []), 0);

  const set = (key: string, value: string) => {
    const el = document.querySelector(`[data-stat="${key}"]`);
    if (el) el.textContent = value;
  };

  set('revenue', formatPrice(revenue));
  set('pending', String(pending));
  set('low', String(lowRows?.length ?? 0));
  set('month-sales', String(monthSold.length));

  if (lowList) {
    if (!lowRows?.length) lowList.innerHTML = '<p class="muted">No hay piezas con stock bajo.</p>';
    else {
      lowList.innerHTML = lowRows
        .map(
          (row) => `
            <article>
              <p>${escapeHtml(row.nombre)} <span>${row.stock} ${row.stock === 1 ? 'unidad' : 'unidades'}</span></p>
              <a href="/admin/productos/editar?codigo=${encodeURIComponent(row.codigo)}">Abrir</a>
            </article>
          `,
        )
        .join('');
    }
  }

  if (recentList) {
    const latest = rows.slice(0, 5);
    if (!latest.length) recentList.innerHTML = '<p class="muted">Aún no hay ventas.</p>';
    else {
      recentList.innerHTML = latest
        .map((row) => {
          const total = saleTotal(row.sale_items ?? []);
          return `
            <article>
              <p>${escapeHtml(customerName(row))} <span>${formatPrice(total)} · ${escapeHtml(saleStatusLabel(row.status))}</span></p>
              <a href="/admin/ventas/editar?id=${encodeURIComponent(row.id)}">Abrir</a>
            </article>
          `;
        })
        .join('');
    }
  }

  type ProductImageRow = { id: string; product_codigo: string; thumb: string; full_url: string };
  type CategoryThumbRow = { slug: string; imagen: string; imagen_thumb?: string | null };
  type HeroThumbRow = { id: string; image_url: string; thumb_url?: string | null };

  const [{ data: productImages }, { data: categoryThumbs }, { data: heroThumbs }] = await Promise.all([
    supabase.from('product_images').select('id, product_codigo, thumb, full_url'),
    supabase.from('categories').select('slug, imagen, imagen_thumb'),
    supabase.from('hero_slides').select('id, image_url, thumb_url'),
  ]);

  const missingProducts = ((productImages ?? []) as ProductImageRow[]).filter((row) => missingThumb(row.thumb, row.full_url));
  const missingCategories = ((categoryThumbs ?? []) as CategoryThumbRow[]).filter((row) =>
    missingThumb(row.imagen_thumb, row.imagen),
  );
  const missingHero = ((heroThumbs ?? []) as HeroThumbRow[]).filter((row) => missingThumb(row.thumb_url, row.image_url));
  const missingTotal = missingProducts.length + missingCategories.length + missingHero.length;

  if (thumbStatus) {
    thumbStatus.textContent = missingTotal
      ? `${missingProducts.length} fotos de producto · ${missingCategories.length} colecciones · ${missingHero.length} slides del hero`
      : 'Todas las fotos del catálogo y el hero ya tienen miniatura.';
  }
  if (backfillBtn) backfillBtn.hidden = missingTotal === 0;

  backfillBtn?.addEventListener('click', async () => {
    backfillBtn.disabled = true;
    try {
      for (const row of missingProducts) {
        const thumbUrl = await generateAndUploadThumb(row.full_url, `products/${row.product_codigo}`);
        const { error } = await supabase.from('product_images').update({ thumb: thumbUrl }).eq('id', row.id);
        if (error) throw error;
      }
      for (const row of missingCategories) {
        const thumbUrl = await generateAndUploadThumb(row.imagen, 'categories');
        const { error } = await supabase.from('categories').update({ imagen_thumb: thumbUrl }).eq('slug', row.slug);
        if (error) throw error;
      }
      for (const row of missingHero) {
        const thumbUrl = await generateAndUploadThumb(row.image_url, 'hero');
        const { error } = await supabase.from('hero_slides').update({ thumb_url: thumbUrl }).eq('id', row.id);
        if (error) throw error;
      }
      if (thumbStatus) thumbStatus.textContent = `Se generaron ${missingTotal} miniaturas.`;
      backfillBtn.hidden = true;
      if (alertEl) {
        alertEl.hidden = false;
        alertEl.classList.remove('is-error');
        alertEl.textContent = 'Miniaturas generadas.';
      }
    } catch (error) {
      backfillBtn.disabled = false;
      if (alertEl) {
        alertEl.hidden = false;
        alertEl.classList.add('is-error');
        alertEl.textContent = error instanceof Error ? error.message : 'No se pudieron generar las miniaturas.';
      }
    }
  });

  if (alertEl && (productError || (salesError && !String(salesError.message).includes('sales')))) {
    alertEl.hidden = false;
    alertEl.classList.add('is-error');
    alertEl.textContent = productError?.message ?? salesError?.message ?? 'No se pudo leer el resumen.';
  } else if (alertEl && productError) {
    alertEl.hidden = false;
    alertEl.classList.add('is-error');
    alertEl.textContent = 'No se pudo leer el catálogo. Corre supabase/dashboard.sql en el SQL Editor.';
  }
</script>
