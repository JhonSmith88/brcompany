---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Quiénes somos">
  <p class="muted">Texto, fotos y pilares de la página pública. En los párrafos puedes usar **negrita**.</p>
  <p class="admin-alert" data-admin-alert hidden></p>

  <form class="admin-form" data-about-form>
    <div class="row-2">
      <label>Antetítulo <input name="eyebrow" required></label>
      <label>Título <input name="title" required></label>
    </div>
    <label>Párrafo 1 <textarea name="paragraph_1" required></textarea></label>
    <label>Párrafo 2 <textarea name="paragraph_2"></textarea></label>
    <label>Párrafo 3 <textarea name="paragraph_3"></textarea></label>
    <label>Descripción para buscadores <input name="description" required></label>
    <label>Botón <input name="cta_label" required></label>
    <label>Mensaje de WhatsApp <textarea name="cta_context" required></textarea></label>
    <div data-about-image></div>
    <div data-about-logo></div>
    <div class="admin-actions">
      <button class="btn btn--gold" type="submit">Guardar texto</button>
    </div>
  </form>

  <h2 class="section-title" style="font-size: 1.6rem; margin-top: 2.5rem">Pilares</h2>
  <p class="muted">Los bloques bajo el texto. Usa Subir / Bajar o arrastra el número para cambiar el orden.</p>
  <div class="admin-actions">
    <button type="button" class="btn btn--outline" data-add-pillar>Añadir pilar</button>
  </div>
  <div class="admin-benefits" data-pillars-list></div>
</AdminLayout>

<script>
  import { requireAdminSession } from '../../lib/admin';
  import { defaultAboutCopy, defaultAboutPillars } from '../../lib/about';
  import { benefitIconOptions, safeImageSrc, sanitizeBenefitIcon } from '../../lib/home';
  import { bindMediaFields, mediaFieldHtml } from '../../lib/media/media-picker';
  import { escapeHtml } from '../../lib/media/ui';

  const gate = await requireAdminSession();
  if (!gate) throw new Error('redirect');
  const { supabase } = gate;
  const form = document.querySelector<HTMLFormElement>('[data-about-form]');
  const alertEl = document.querySelector('[data-admin-alert]');
  const pillarsList = document.querySelector('[data-pillars-list]');
  const imageSlot = document.querySelector('[data-about-image]');
  const logoSlot = document.querySelector('[data-about-logo]');

  const show = (message: string, error = false) => {
    if (!alertEl) return;
    alertEl.hidden = false;
    alertEl.textContent = message;
    alertEl.classList.toggle('is-error', error);
  };

  function mountMedia(slot: Element | null, name: string, label: string, value: string) {
    if (!slot) return;
    slot.innerHTML = mediaFieldHtml({ name, label, value, folder: 'about' });
    bindMediaFields(slot);
  }

  function fillForm(row: {
    eyebrow: string;
    title: string;
    paragraph_1: string;
    paragraph_2: string;
    paragraph_3: string;
    description: string;
    cta_label: string;
    cta_context: string;
    image_url: string;
    logo_url: string;
  }) {
    if (!form) return;
    const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement;
    field('eyebrow').value = row.eyebrow;
    field('title').value = row.title;
    field('paragraph_1').value = row.paragraph_1;
    field('paragraph_2').value = row.paragraph_2;
    field('paragraph_3').value = row.paragraph_3;
    field('description').value = row.description;
    field('cta_label').value = row.cta_label;
    field('cta_context').value = row.cta_context;
    mountMedia(imageSlot, 'image_url', 'Foto de fondo', row.image_url);
    mountMedia(logoSlot, 'logo_url', 'Logo / escudo', row.logo_url);
  }

  async function loadCopy() {
    const { data, error } = await supabase.from('about_page').select('*').eq('id', 'about').maybeSingle();
    if (error) {
      show('Falta la tabla about_page. Corre supabase/about.sql en el SQL Editor.', true);
      fillForm({
        eyebrow: defaultAboutCopy.eyebrow,
        title: defaultAboutCopy.title,
        paragraph_1: defaultAboutCopy.paragraph1,
        paragraph_2: defaultAboutCopy.paragraph2,
        paragraph_3: defaultAboutCopy.paragraph3,
        description: defaultAboutCopy.description,
        cta_label: defaultAboutCopy.ctaLabel,
        cta_context: defaultAboutCopy.ctaContext,
        image_url: defaultAboutCopy.imageUrl,
        logo_url: defaultAboutCopy.logoUrl,
      });
      return;
    }
    if (data) {
      fillForm(data);
      return;
    }
    const seed = {
      id: 'about',
      eyebrow: defaultAboutCopy.eyebrow,
      title: defaultAboutCopy.title,
      paragraph_1: defaultAboutCopy.paragraph1,
      paragraph_2: defaultAboutCopy.paragraph2,
      paragraph_3: defaultAboutCopy.paragraph3,
      description: defaultAboutCopy.description,
      cta_label: defaultAboutCopy.ctaLabel,
      cta_context: defaultAboutCopy.ctaContext,
      image_url: defaultAboutCopy.imageUrl,
      logo_url: defaultAboutCopy.logoUrl,
    };
    const { error: insertError } = await supabase.from('about_page').insert(seed);
    if (insertError) show(insertError.message, true);
    fillForm(seed);
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const payload = new FormData(form);
    const row = {
      id: 'about',
      eyebrow: String(payload.get('eyebrow') ?? '').trim(),
      title: String(payload.get('title') ?? '').trim(),
      paragraph_1: String(payload.get('paragraph_1') ?? '').trim(),
      paragraph_2: String(payload.get('paragraph_2') ?? '').trim(),
      paragraph_3: String(payload.get('paragraph_3') ?? '').trim(),
      description: String(payload.get('description') ?? '').trim(),
      cta_label: String(payload.get('cta_label') ?? '').trim(),
      cta_context: String(payload.get('cta_context') ?? '').trim(),
      image_url: safeImageSrc(String(payload.get('image_url') ?? ''), defaultAboutCopy.imageUrl),
      logo_url: safeImageSrc(String(payload.get('logo_url') ?? ''), defaultAboutCopy.logoUrl),
      updated_at: new Date().toISOString(),
    };
    const { error } = await supabase.from('about_page').upsert(row);
    if (error) show(error.message, true);
    else {
      fillForm(row);
      show('Quiénes somos guardado.');
    }
  });

  function iconSelect(selected: string) {
    return benefitIconOptions
      .map((option) => `<option value="${option.value}" ${option.value === selected ? 'selected' : ''}>${option.label}</option>`)
      .join('');
  }

  type PillarRow = {
    id: string;
    title: string;
    text: string;
    icon: string;
    sort_order: number;
    active: boolean;
  };

  function pillarCard(row: PillarRow, index: number, total: number) {
    return `
      <article data-pillar-id="${escapeHtml(row.id)}">
        <div class="admin-benefits__head">
          <button type="button" class="admin-benefits__pos" data-pillar-drag draggable="true" title="Arrastrar para reordenar" aria-label="Posición ${index + 1}">
            ${index + 1}
          </button>
          <div class="admin-order-btns">
            <button type="button" data-pillar-move="-1" ${index <= 0 ? 'disabled' : ''}>Subir</button>
            <button type="button" data-pillar-move="1" ${index >= total - 1 ? 'disabled' : ''}>Bajar</button>
          </div>
        </div>
        <div class="row-2">
          <label>Título <input type="text" value="${escapeHtml(row.title)}" data-pillar-title></label>
          <label>Icono <select data-pillar-icon>${iconSelect(sanitizeBenefitIcon(row.icon))}</select></label>
        </div>
        <label>Texto <input type="text" value="${escapeHtml(row.text)}" data-pillar-text></label>
        <div class="admin-benefits__meta">
          <label class="admin-check"><input type="checkbox" data-pillar-active ${row.active ? 'checked' : ''}> Visible</label>
          <button type="button" data-pillar-save>Guardar</button>
          <button type="button" data-pillar-delete>Quitar</button>
        </div>
      </article>
    `;
  }

  function readPillars(): PillarRow[] {
    if (!pillarsList) return [];
    return [...pillarsList.querySelectorAll<HTMLElement>('[data-pillar-id]')].map((card, index) => ({
      id: card.dataset.pillarId ?? '',
      title: card.querySelector<HTMLInputElement>('[data-pillar-title]')?.value ?? '',
      text: card.querySelector<HTMLInputElement>('[data-pillar-text]')?.value ?? '',
      icon: sanitizeBenefitIcon(card.querySelector<HTMLSelectElement>('[data-pillar-icon]')?.value ?? 'shield'),
      sort_order: index,
      active: card.querySelector<HTMLInputElement>('[data-pillar-active]')?.checked ?? true,
    }));
  }

  function paintPillars(rows: PillarRow[]) {
    if (!pillarsList) return;
    pillarsList.innerHTML = rows.map((row, index) => pillarCard(row, index, rows.length)).join('');
  }

  async function persistPillarOrder(rows: PillarRow[]) {
    const results = await Promise.all(
      rows.map((row, index) => supabase.from('about_pillars').update({ sort_order: index }).eq('id', row.id)),
    );
    const failed = results.find((result) => result.error);
    if (failed?.error) throw failed.error;
  }

  async function movePillar(id: string, delta: number) {
    const rows = readPillars();
    const index = rows.findIndex((row) => row.id === id);
    const nextIndex = index + delta;
    if (index < 0 || nextIndex < 0 || nextIndex >= rows.length) return;
    [rows[index], rows[nextIndex]] = [rows[nextIndex], rows[index]];
    paintPillars(rows);
    try {
      await persistPillarOrder(rows);
    } catch (error) {
      show(error instanceof Error ? error.message : 'No se pudo reordenar.', true);
      await renderPillars();
    }
  }

  async function renderPillars() {
    const { data, error } = await supabase.from('about_pillars').select('*').order('sort_order');
    if (error) {
      show('Falta la tabla about_pillars. Corre supabase/about.sql en el SQL Editor.', true);
      return;
    }
    if (!data?.length) {
      const seed = defaultAboutPillars.map((item, index) => ({
        ...item,
        sort_order: index,
        active: true,
      }));
      const { data: inserted, error: insertError } = await supabase.from('about_pillars').insert(seed).select();
      if (insertError) {
        show(insertError.message, true);
        return;
      }
      paintPillars((inserted ?? []) as PillarRow[]);
      return;
    }
    paintPillars(data as PillarRow[]);
  }

  document.querySelector('[data-add-pillar]')?.addEventListener('click', async () => {
    const { count } = await supabase.from('about_pillars').select('*', { count: 'exact', head: true });
    const { error } = await supabase.from('about_pillars').insert({
      title: 'Nuevo pilar',
      text: '',
      icon: 'star',
      sort_order: count ?? 0,
      active: true,
    });
    if (error) show(error.message, true);
    else {
      await renderPillars();
      show('Pilar añadido.');
    }
  });

  pillarsList?.addEventListener('click', async (event) => {
    const target = event.target as HTMLElement;
    const card = target.closest<HTMLElement>('[data-pillar-id]');
    if (!card) return;
    const id = card.dataset.pillarId!;

    if (target.closest('[data-pillar-move]')) {
      const delta = Number((target.closest('[data-pillar-move]') as HTMLElement).dataset.pillarMove);
      await movePillar(id, delta);
      return;
    }

    if (target.closest('[data-pillar-save]')) {
      const title = card.querySelector<HTMLInputElement>('[data-pillar-title]')?.value.trim() ?? '';
      const text = card.querySelector<HTMLInputElement>('[data-pillar-text]')?.value.trim() ?? '';
      const icon = sanitizeBenefitIcon(card.querySelector<HTMLSelectElement>('[data-pillar-icon]')?.value ?? 'shield');
      const sort_order = readPillars().findIndex((row) => row.id === id);
      const active = card.querySelector<HTMLInputElement>('[data-pillar-active]')?.checked ?? true;
      if (!title) {
        show('El título del pilar no puede estar vacío.', true);
        return;
      }
      const { error } = await supabase.from('about_pillars').update({ title, text, icon, sort_order, active }).eq('id', id);
      show(error ? error.message : 'Pilar guardado.', Boolean(error));
      if (!error) await renderPillars();
      return;
    }

    if (target.closest('[data-pillar-delete]')) {
      const { error } = await supabase.from('about_pillars').delete().eq('id', id);
      if (error) show(error.message, true);
      else {
        await renderPillars();
        show('Pilar quitado.');
      }
    }
  });

  function refreshPillarPositions() {
    if (!pillarsList) return;
    const cards = [...pillarsList.querySelectorAll<HTMLElement>('[data-pillar-id]')];
    cards.forEach((card, index) => {
      const pos = card.querySelector('[data-pillar-drag]');
      if (pos) {
        pos.textContent = String(index + 1);
        pos.setAttribute('aria-label', `Posición ${index + 1}`);
      }
      const up = card.querySelector<HTMLButtonElement>('[data-pillar-move="-1"]');
      const down = card.querySelector<HTMLButtonElement>('[data-pillar-move="1"]');
      if (up) up.disabled = index === 0;
      if (down) down.disabled = index === cards.length - 1;
    });
  }

  pillarsList?.addEventListener('dragstart', (event) => {
    const handle = (event.target as HTMLElement).closest('[data-pillar-drag]');
    const card = handle?.closest<HTMLElement>('[data-pillar-id]');
    if (!card || !event.dataTransfer) {
      event.preventDefault();
      return;
    }
    event.dataTransfer.effectAllowed = 'move';
    card.classList.add('is-dragging');
  });

  pillarsList?.addEventListener('dragend', async () => {
    pillarsList.querySelectorAll('.is-dragging').forEach((el) => el.classList.remove('is-dragging'));
    refreshPillarPositions();
    try {
      await persistPillarOrder(readPillars());
    } catch (error) {
      show(error instanceof Error ? error.message : 'No se pudo reordenar.', true);
      await renderPillars();
    }
  });

  pillarsList?.addEventListener('dragover', (event) => {
    const over = (event.target as HTMLElement).closest<HTMLElement>('[data-pillar-id]');
    const dragging = pillarsList.querySelector<HTMLElement>('.is-dragging');
    if (!over || !dragging || over === dragging) return;
    event.preventDefault();
    const cards = [...pillarsList.querySelectorAll<HTMLElement>('[data-pillar-id]')];
    const overIndex = cards.indexOf(over);
    const dragIndex = cards.indexOf(dragging);
    if (overIndex < 0 || dragIndex < 0) return;
    if (dragIndex < overIndex) over.after(dragging);
    else over.before(dragging);
    refreshPillarPositions();
  });

  await loadCopy();
  await renderPillars();
</script>
