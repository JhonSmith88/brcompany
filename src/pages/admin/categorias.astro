---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Categorías">
  <p class="muted">Colecciones del catálogo. La vitrina del inicio se ajusta también en Inicio → Vitrina.</p>
  <p class="admin-alert" data-admin-alert hidden></p>
  <div class="admin-actions">
    <a class="btn btn--gold" href="/admin/categorias/editar">Nueva categoría</a>
    <a class="btn btn--outline" href="/admin/productos">Productos</a>
  </div>
  <form class="admin-filters" data-category-filters>
    <label>Buscar <input type="search" name="q" placeholder="Nombre, slug o descripción"></label>
  </form>
  <p class="muted" data-category-count></p>
  <div style="overflow:auto">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Foto</th>
          <th>Nombre</th>
          <th>Piezas</th>
          <th>Vitrina</th>
          <th>Orden</th>
          <th></th>
        </tr>
      </thead>
      <tbody data-category-rows></tbody>
    </table>
  </div>
</AdminLayout>

<script>
  import { requireAdminSession } from '../../lib/admin';
  import { writeFilterUrl } from '../../lib/admin-sales';
  import { escapeHtml } from '../../lib/media/ui';

  const gate = await requireAdminSession();
  if (!gate) throw new Error('redirect');
  const { supabase } = gate;
  const alertEl = document.querySelector('[data-admin-alert]');
  const body = document.querySelector('[data-category-rows]');
  const countEl = document.querySelector('[data-category-count]');
  const filters = document.querySelector<HTMLFormElement>('[data-category-filters]');

  type CategoryRow = {
    slug: string;
    nombre: string;
    descripcion: string;
    imagen: string;
    orden: number;
    en_vitrina?: boolean | null;
  };

  const show = (message: string, error = false) => {
    if (!alertEl) return;
    alertEl.hidden = false;
    alertEl.textContent = message;
    alertEl.classList.toggle('is-error', error);
  };

  const [{ data: categories, error }, { data: products }] = await Promise.all([
    supabase.from('categories').select('slug, nombre, descripcion, imagen, orden, en_vitrina').order('orden'),
    supabase.from('products').select('categoria_slug, stock'),
  ]);

  if (error) show(error.message, true);

  const params = new URLSearchParams(window.location.search);
  const searchField = filters?.elements.namedItem('q') as HTMLInputElement | null;
  if (searchField) searchField.value = params.get('q') ?? '';

  const productCount = new Map<string, number>();
  const lowCount = new Map<string, number>();
  for (const row of products ?? []) {
    productCount.set(row.categoria_slug, (productCount.get(row.categoria_slug) ?? 0) + 1);
    if (Number(row.stock ?? 0) <= 3) {
      lowCount.set(row.categoria_slug, (lowCount.get(row.categoria_slug) ?? 0) + 1);
    }
  }

  let rows = (categories ?? []) as CategoryRow[];

  async function persistOrder(next: CategoryRow[]) {
    const updates = next.map((row, index) =>
      supabase.from('categories').update({ orden: index + 1 }).eq('slug', row.slug),
    );
    const results = await Promise.all(updates);
    const failed = results.find((result) => result.error);
    if (failed?.error) throw failed.error;
    rows = next.map((row, index) => ({ ...row, orden: index + 1 }));
  }

  function currentQuery() {
    return String((filters ? new FormData(filters) : new FormData()).get('q') ?? '').trim();
  }

  function render() {
    const q = currentQuery();
    writeFilterUrl(['q'], { q });
    const visible = rows.filter((row) => {
      if (!q) return true;
      return `${row.nombre} ${row.slug} ${row.descripcion}`.toLowerCase().includes(q.toLowerCase());
    });
    if (countEl) countEl.textContent = `${visible.length} de ${rows.length} categorías`;
    if (!body) return;
    if (!visible.length) {
      body.innerHTML = '<tr><td colspan="6">No hay categorías con esa búsqueda.</td></tr>';
      return;
    }
    body.innerHTML = visible
      .map((row) => {
        const pieces = productCount.get(row.slug) ?? 0;
        const low = lowCount.get(row.slug) ?? 0;
        const inVitrina = row.en_vitrina !== false;
        const index = rows.findIndex((item) => item.slug === row.slug);
        return `
          <tr>
            <td>${row.imagen ? `<img src="${escapeHtml(row.imagen)}" alt="">` : ''}</td>
            <td>${escapeHtml(row.nombre)}<span class="admin-table-sub">${escapeHtml(row.slug)}</span></td>
            <td>
              <a href="/admin/productos?categoria=${encodeURIComponent(row.slug)}">${pieces}</a>
              ${low ? `<span class="admin-table-sub">${low} con stock bajo</span>` : ''}
            </td>
            <td><span class="admin-sale-status ${inVitrina ? 'admin-sale-status--vendido' : 'admin-sale-status--cancelado'}">${inVitrina ? 'Visible' : 'Oculta'}</span></td>
            <td>
              <div class="admin-order-btns">
                <button type="button" data-move="-1" data-slug="${escapeHtml(row.slug)}" ${index <= 0 ? 'disabled' : ''}>Subir</button>
                <button type="button" data-move="1" data-slug="${escapeHtml(row.slug)}" ${index >= rows.length - 1 ? 'disabled' : ''}>Bajar</button>
              </div>
            </td>
            <td>
              <a href="/admin/categorias/editar?slug=${encodeURIComponent(row.slug)}">Editar</a>
              <span class="admin-table-sub"><a href="/catalogo/${encodeURIComponent(row.slug)}" target="_blank" rel="noopener">Ver catálogo</a></span>
            </td>
          </tr>
        `;
      })
      .join('');
  }

  filters?.addEventListener('input', render);

  body?.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-move]');
    if (!button) return;
    const slug = button.dataset.slug ?? '';
    const delta = Number(button.dataset.move);
    const index = rows.findIndex((row) => row.slug === slug);
    const nextIndex = index + delta;
    if (index < 0 || nextIndex < 0 || nextIndex >= rows.length) return;
    const next = [...rows];
    [next[index], next[nextIndex]] = [next[nextIndex], next[index]];
    try {
      await persistOrder(next);
      render();
    } catch (err) {
      show(err instanceof Error ? err.message : 'No se pudo reordenar.', true);
    }
  });

  render();
</script>
