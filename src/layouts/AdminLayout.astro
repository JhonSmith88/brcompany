---
import '@fontsource-variable/cormorant-garamond/wght.css';
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/600.css';
import '../styles/global.css';
import AdminNavIcon from '../components/AdminNavIcon.astro';
import { site } from '../data/site';

interface Props {
  title: string;
}

const { title } = Astro.props;
const pathname = Astro.url.pathname;
const pageTitle = `${title} · Panel ${site.name}`;

const links = [
  { href: '/admin/panel', label: 'Resumen', icon: 'panel' },
  { href: '/admin/inicio', label: 'Inicio', icon: 'home' },
  { href: '/admin/quienes-somos', label: 'Quiénes somos', icon: 'about' },
  { href: '/admin/catalogo', label: 'Catálogo', icon: 'catalog' },
  { href: '/admin/contacto', label: 'Contacto', icon: 'contact' },
  { href: '/admin/categorias', label: 'Categorías', icon: 'categories' },
  { href: '/admin/productos', label: 'Productos', icon: 'products' },
  { href: '/admin/clientes', label: 'Clientes', icon: 'customers' },
  { href: '/admin/ventas', label: 'Ventas', icon: 'sales' },
  { href: '/admin/ajustes', label: 'Ajustes', icon: 'settings' },
];

function isActive(href: string) {
  if (href === '/admin/panel') return pathname === href;
  return pathname === href || pathname.startsWith(`${href}/`);
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <title>{pageTitle}</title>
  </head>
  <body class="admin-body">
    <div class="shell" data-admin-shell>
      <button type="button" class="shell__backdrop" data-nav-backdrop aria-label="Cerrar menú"></button>
      <aside class="shell__nav" data-admin-nav id="admin-nav">
        <div class="shell__brand-row">
          <a class="shell__brand" href="/admin/panel">
            <img src="/logo.png" alt="" width="40" height="40" />
            <span>{site.name}</span>
          </a>
          <button type="button" class="shell__nav-hide" data-nav-toggle aria-controls="admin-nav" aria-expanded="true" aria-label="Ocultar menú" title="Ocultar menú">
            <AdminNavIcon name="collapse" />
          </button>
        </div>
        <nav>
          <ul>
            {
              links.map((link) => (
                <li>
                  <a href={link.href} class:list={[{ 'is-active': isActive(link.href) }]}>
                    <AdminNavIcon name={link.icon} />
                    <span>{link.label}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <a class="shell__store" href="/" target="_blank" rel="noopener noreferrer">
          <AdminNavIcon name="store" />
          <span>Ver tienda</span>
        </a>
      </aside>

      <div class="shell__main">
        <header class="shell__top">
          <div class="shell__top-left">
            <button type="button" class="shell__menu-btn" data-nav-toggle aria-controls="admin-nav" aria-expanded="true">
              <AdminNavIcon name="menu" />
              <span>Menú</span>
            </button>
            <h1>{title}</h1>
          </div>
          <div class="shell__user">
            <span data-admin-email></span>
            <button type="button" data-sign-out>Cerrar sesión</button>
          </div>
        </header>
        <div class="shell__content">
          <slot />
        </div>
      </div>
    </div>
    <div class="admin-toast" data-admin-toast hidden></div>
  </body>
</html>

<style is:global>
  body.admin-body {
    min-height: 100dvh;
    background: #070707;
    background-image: none;
    color: var(--color-silver);
  }

  .shell {
    display: grid;
    grid-template-columns: 16.5rem minmax(0, 1fr);
    min-height: 100dvh;
    transition: grid-template-columns 0.28s ease;
  }

  .shell.is-nav-hidden {
    grid-template-columns: 0 minmax(0, 1fr);
  }

  .shell__backdrop {
    display: none;
  }

  .shell__nav {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    min-width: 16.5rem;
    padding: 1.35rem 1rem 1.2rem;
    border-right: 1px solid rgb(201 162 39 / 0.16);
    background: #0b0b0b;
    overflow: hidden;
  }

  .shell.is-nav-hidden .shell__nav {
    visibility: hidden;
    pointer-events: none;
  }

  .shell__brand-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .shell__brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-width: 0;
    padding: 0;
    font-family: var(--font-display);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-gold-bright);
  }

  .shell__brand:hover,
  .shell__brand.is-active {
    background: none;
  }

  .shell__brand img {
    width: 2.4rem;
    height: 2.4rem;
    object-fit: cover;
    object-position: center 36%;
    border-radius: 50%;
  }

  .shell__nav nav {
    min-height: 0;
    overflow: auto;
  }

  .shell__nav ul {
    display: grid;
    gap: 0.25rem;
  }

  .shell__nav a {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.7rem 0.85rem;
    border-radius: 2px;
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-silver);
  }

  .shell__nav a svg,
  .shell__nav-hide svg,
  .shell__menu-btn svg {
    flex: 0 0 auto;
    width: 1.15rem;
    height: 1.15rem;
  }

  .shell__nav a:hover,
  .shell__nav a.is-active {
    color: var(--color-gold-bright);
    background: rgb(201 162 39 / 0.08);
  }

  .shell__store {
    margin-top: auto;
    color: var(--color-gold) !important;
  }

  .shell__nav-hide {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    margin-top: 0.15rem;
    border: 0;
    background: transparent;
    color: var(--color-silver-dim);
  }

  .shell__nav-hide:hover {
    color: var(--color-gold-bright);
    background: rgb(201 162 39 / 0.08);
  }

  .shell__menu-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.65rem;
    border: 1px solid rgb(201 162 39 / 0.22);
    background: #101010;
    color: var(--color-gold-bright);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .shell__menu-btn:hover {
    border-color: var(--color-gold);
    background: rgb(201 162 39 / 0.08);
  }

  .shell__top-left {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-width: 0;
  }

  .shell.is-nav-hidden .shell__menu-btn {
    display: inline-flex;
  }

  .shell:not(.is-nav-hidden) .shell__menu-btn {
    display: none;
  }

  .shell__main {
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .shell__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.25rem;
    padding: 0 1.4rem;
    border-bottom: 1px solid rgb(201 162 39 / 0.14);
  }

  .shell__top h1 {
    margin: 0;
    font-size: 1.45rem;
  }

  .shell__user {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.84rem;
    color: var(--color-silver-dim);
  }

  .shell__user button {
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-silver);
  }

  .shell__user button:hover {
    color: var(--color-gold-bright);
  }

  .shell__content {
    padding: 1.5rem 1.4rem 2.5rem;
  }

  .admin-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .admin-card {
    display: block;
    padding: 1.15rem 1.2rem;
    border: 1px solid rgb(201 162 39 / 0.16);
    background: #101010;
  }

  .admin-card:hover {
    border-color: rgb(201 162 39 / 0.38);
  }

  .admin-card span {
    display: block;
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-gold);
  }

  .admin-card strong {
    display: block;
    margin-top: 0.45rem;
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 500;
    color: var(--color-white);
  }

  .admin-section-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    max-width: 52rem;
    margin-top: 1.15rem;
  }

  .admin-section-card {
    display: grid;
    gap: 0.4rem;
    min-height: 7.5rem;
    padding: 1.2rem 1.25rem;
    border: 1px solid rgb(201 162 39 / 0.16);
    background: #101010;
  }

  .admin-section-card:hover {
    border-color: rgb(201 162 39 / 0.38);
    background: rgb(201 162 39 / 0.06);
  }

  .admin-section-card strong {
    font-family: var(--font-display);
    font-size: 1.55rem;
    font-weight: 500;
    color: var(--color-white);
  }

  .admin-section-card span {
    color: var(--color-silver-dim);
    font-size: 0.9rem;
    letter-spacing: 0;
    text-transform: none;
  }

  .admin-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
  }

  .admin-table th,
  .admin-table td {
    padding: 0.85rem 0.7rem;
    border-bottom: 1px solid rgb(201 162 39 / 0.12);
    text-align: left;
    vertical-align: middle;
  }

  .admin-table th {
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-gold);
    font-weight: 500;
  }

  .admin-table img {
    width: 3.4rem;
    height: 3.4rem;
    object-fit: cover;
    background: #111;
  }

  .admin-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .admin-filters {
    display: grid;
    grid-template-columns: minmax(12rem, 1.6fr) repeat(3, minmax(8rem, 1fr));
    gap: 0.85rem;
    max-width: 56rem;
    margin: 0 0 1.1rem;
  }

  .admin-filters label {
    display: grid;
    gap: 0.35rem;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-gold);
  }

  .admin-filters input,
  .admin-filters select {
    width: 100%;
    min-height: 2.7rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid rgb(201 162 39 / 0.22);
    background: #101010;
    color: var(--color-white);
    font: inherit;
    font-size: 0.95rem;
    text-transform: none;
    letter-spacing: 0;
  }

  .admin-filters input[type='search'] {
    appearance: none;
  }

  .admin-filters input::placeholder {
    color: rgb(245 240 232 / 0.4);
  }

  .admin-filters--sales {
    grid-template-columns: minmax(12rem, 1.5fr) repeat(4, minmax(7.5rem, 1fr));
    max-width: 70rem;
  }

  .admin-customer-box {
    display: grid;
    gap: 0.65rem;
    max-width: 46rem;
    margin: 0 0 0.85rem;
    padding: 0.85rem 0.95rem;
    border: 1px solid rgb(201 162 39 / 0.16);
    background: #101010;
  }

  .admin-customer-box p {
    margin: 0;
  }

  .admin-pay--pagado {
    color: #b8d4b4;
  }

  .admin-pay--sena {
    color: var(--color-gold-bright);
  }

  .admin-pay--cobrar {
    color: #e8b0b0;
  }

  .admin-panel-block {
    margin-top: 2rem;
    max-width: 46rem;
  }

  .admin-panel-block h2 {
    margin: 0 0 0.35rem;
    font-size: 1.35rem;
  }

  .admin-stock,
  .admin-sale-status {
    display: inline-block;
    padding: 0.15rem 0.45rem;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .admin-stock--ok {
    color: #b8d4b4;
  }

  .admin-stock--bajo,
  .admin-sale-status--pendiente {
    color: var(--color-gold-bright);
  }

  .admin-stock--agotado,
  .admin-sale-status--cancelado {
    color: #e8b0b0;
  }

  .admin-sale-status--vendido {
    color: #b8d4b4;
  }

  .admin-table-sub {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-silver-dim);
  }

  .admin-order-btns {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .admin-order-btns button {
    padding: 0.2rem 0.45rem;
    border: 1px solid rgb(201 162 39 / 0.22);
    background: #101010;
    color: var(--color-gold-bright);
    font: inherit;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .admin-order-btns button:disabled {
    opacity: 0.35;
  }

  .admin-sale-items,
  .admin-history {
    display: grid;
    gap: 0.65rem;
    max-width: 46rem;
    margin: 0.5rem 0 1rem;
  }

  .admin-sale-items article,
  .admin-history article {
    display: grid;
    grid-template-columns: 4.2rem minmax(0, 1fr) 4.8rem 5.5rem auto;
    gap: 0.65rem;
    align-items: center;
    padding: 0.55rem 0.65rem;
    border: 1px solid rgb(201 162 39 / 0.16);
    background: #101010;
  }

  .admin-history article {
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .admin-sale-items img,
  .admin-sale-items .admin-carousel__empty {
    width: 4.2rem;
    height: 4.2rem;
    object-fit: cover;
    background: #111;
  }

  .admin-sale-items p,
  .admin-history p {
    margin: 0;
    min-width: 0;
  }

  .admin-sale-items p span,
  .admin-history p span {
    display: block;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-silver-dim);
  }

  .admin-sale-items label {
    display: grid;
    gap: 0.25rem;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-gold);
  }

  .admin-sale-items input {
    width: 100%;
    min-height: 2.3rem;
    padding: 0.3rem 0.45rem;
    border: 1px solid rgb(201 162 39 / 0.22);
    background: #0c0c0c;
    color: var(--color-white);
    font: inherit;
  }

  .admin-sale-items button,
  .admin-history a {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-gold-bright);
  }

  .admin-actions .btn:disabled {
    opacity: 0.4;
    pointer-events: none;
    transform: none;
  }

  .admin-form {
    display: grid;
    gap: 0.95rem;
    max-width: 46rem;
  }

  .admin-form label,
  .admin-field {
    display: grid;
    gap: 0.35rem;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-gold);
  }

  .admin-form input,
  .admin-form textarea,
  .admin-form select {
    width: 100%;
    min-height: 2.7rem;
    padding: 0.55rem 0.75rem;
    border: 1px solid rgb(201 162 39 / 0.22);
    background: #101010;
    color: var(--color-white);
    font: inherit;
    text-transform: none;
    letter-spacing: 0;
  }

  .admin-form textarea {
    min-height: 7.5rem;
    resize: vertical;
  }

  .admin-check {
    display: flex !important;
    flex-direction: row;
    align-items: center;
    gap: 0.55rem;
    text-transform: none;
    letter-spacing: 0;
    color: var(--color-silver);
  }

  .admin-check input {
    width: auto;
    min-height: 0;
  }

  .admin-alert {
    margin: 0 0 1rem;
    padding: 0.7rem 0.85rem;
    border: 1px solid rgb(201 162 39 / 0.28);
    color: var(--color-gold-bright);
    font-size: 0.9rem;
  }

  .admin-alert.is-error {
    border-color: rgb(184 69 69 / 0.5);
    color: #e8b0b0;
  }

  .admin-thumb {
    width: 7rem;
    height: 5.2rem;
    object-fit: cover;
    background: #111;
    border: 1px solid rgb(201 162 39 / 0.16);
  }

  .admin-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    gap: 0.85rem;
  }

  .admin-gallery article {
    display: grid;
    gap: 0.4rem;
    padding: 0.55rem;
    border: 1px solid rgb(201 162 39 / 0.16);
    background: #101010;
  }

  .admin-gallery img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .admin-gallery input[type='text'],
  .admin-gallery input[type='number'] {
    width: 100%;
    min-height: 2.2rem;
    padding: 0.35rem 0.5rem;
    border: 1px solid rgb(201 162 39 / 0.22);
    background: #0c0c0c;
    color: var(--color-white);
    font: inherit;
  }

  .admin-gallery button {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-gold-bright);
    text-align: left;
  }

  .admin-hero-slides {
    display: grid;
    gap: 0.85rem;
    max-width: 46rem;
  }

  .admin-hero-slide {
    display: grid;
    grid-template-columns: 13.5rem minmax(0, 1fr);
    gap: 0.9rem;
    align-items: start;
    padding: 0.7rem;
    border: 1px solid rgb(201 162 39 / 0.16);
    background: #101010;
  }

  .admin-hero-slide__preview {
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border: 1px solid rgb(201 162 39 / 0.14);
    background: #111;
  }

  .admin-hero-slide__preview img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 32%;
  }

  .admin-hero-slide__fields {
    display: grid;
    gap: 0.65rem;
  }

  .admin-hero-slide__fields label:not(.admin-check) {
    display: grid;
    gap: 0.35rem;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-gold);
  }

  .admin-hero-slide__fields input[type='text'],
  .admin-hero-slide__fields input[type='number'] {
    width: 100%;
    min-height: 2.4rem;
    padding: 0.35rem 0.55rem;
    border: 1px solid rgb(201 162 39 / 0.22);
    background: #0c0c0c;
    color: var(--color-white);
    font: inherit;
    text-transform: none;
    letter-spacing: 0;
  }

  .admin-hero-slide__meta {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 0.75rem;
    align-items: end;
  }

  .admin-hero-slide__fields button:not(.btn) {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-gold-bright);
  }

  @media (max-width: 640px) {
    .admin-hero-slide {
      grid-template-columns: 1fr;
    }

    .admin-hero-slide__preview {
      max-width: 16rem;
    }
  }

  .admin-carousel {
    display: grid;
    gap: 0.65rem;
    max-width: 46rem;
    margin: 0.5rem 0 2rem;
  }

  .admin-carousel article {
    display: grid;
    grid-template-columns: 1.1rem 4.4rem minmax(0, 1fr) auto;
    gap: 0.7rem;
    align-items: center;
    padding: 0.55rem 0.65rem;
    border: 1px solid rgb(201 162 39 / 0.16);
    background: #101010;
    cursor: grab;
  }

  .admin-carousel article.is-dragging {
    opacity: 0.45;
    cursor: grabbing;
  }

  .admin-carousel__handle {
    width: 0.7rem;
    height: 1.15rem;
    justify-self: center;
    background-image: radial-gradient(circle, rgb(201 162 39 / 0.7) 1px, transparent 1.4px);
    background-size: 0.35rem 0.38rem;
    cursor: grab;
  }

  .admin-carousel img,
  .admin-carousel__empty {
    width: 4.4rem;
    height: 4.4rem;
    object-fit: cover;
    background: #111;
    border: 1px solid rgb(201 162 39 / 0.14);
  }

  .admin-carousel p {
    margin: 0;
    min-width: 0;
  }

  .admin-carousel p span {
    display: block;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-silver-dim);
  }

  .admin-carousel button {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-gold-bright);
    text-align: left;
  }

  @media (max-width: 640px) {
    .admin-carousel article {
      grid-template-columns: 1.1rem 4.4rem minmax(0, 1fr);
    }

    .admin-carousel [data-carousel-delete] {
      grid-column: 3;
    }
  }

  .admin-marks {
    display: grid;
    gap: 0.65rem;
    max-width: 46rem;
    margin: 0.5rem 0 2rem;
  }

  .admin-marks article {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 4.5rem auto auto auto;
    gap: 0.55rem;
    align-items: center;
    padding: 0.55rem 0.65rem;
    border: 1px solid rgb(201 162 39 / 0.16);
    background: #101010;
  }

  .admin-marks input[type='text'],
  .admin-marks input[type='number'] {
    width: 100%;
    min-height: 2.4rem;
