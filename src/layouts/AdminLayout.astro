<script>
  import { requireAdminSession } from '../lib/admin';
  import { getSupabase } from '../lib/supabase';

  const session = await requireAdminSession();
  const email = document.querySelector('[data-admin-email]');
  if (session && email) email.textContent = session.session.user.email ?? '';

  const shell = document.querySelector<HTMLElement>('[data-admin-shell]');
  const navToggles = [...document.querySelectorAll<HTMLButtonElement>('[data-nav-toggle]')];
  const backdrop = document.querySelector<HTMLButtonElement>('[data-nav-backdrop]');
  const navQuery = window.matchMedia('(max-width: 900px)');
  const NAV_KEY = 'rb-admin-nav';

  function syncNavButtons() {
    const mobile = navQuery.matches;
    const open = mobile ? shell?.classList.contains('is-nav-open') : !shell?.classList.contains('is-nav-hidden');
    navToggles.forEach((btn) => {
      btn.setAttribute('aria-expanded', String(Boolean(open)));
      const label = btn.querySelector('span');
      if (btn.classList.contains('shell__menu-btn') && label) label.textContent = open && mobile ? 'Cerrar' : 'Menú';
    });
  }

  function applyNav() {
    if (!shell) return;
    if (navQuery.matches) {
      shell.classList.remove('is-nav-hidden');
      shell.classList.remove('is-nav-open');
      document.body.style.overflow = '';
    } else {
      shell.classList.remove('is-nav-open');
      shell.classList.toggle('is-nav-hidden', localStorage.getItem(NAV_KEY) === 'hidden');
      document.body.style.overflow = '';
    }
    syncNavButtons();
  }

  function toggleNav() {
    if (!shell) return;
    if (navQuery.matches) {
      const open = !shell.classList.contains('is-nav-open');
      shell.classList.toggle('is-nav-open', open);
      document.body.style.overflow = open ? 'hidden' : '';
    } else {
      const hidden = !shell.classList.contains('is-nav-hidden');
      shell.classList.toggle('is-nav-hidden', hidden);
      localStorage.setItem(NAV_KEY, hidden ? 'hidden' : 'open');
    }
    syncNavButtons();
  }

  applyNav();
  navQuery.addEventListener('change', applyNav);
  navToggles.forEach((btn) => btn.addEventListener('click', toggleNav));
  backdrop?.addEventListener('click', () => {
    shell?.classList.remove('is-nav-open');
    document.body.style.overflow = '';
    syncNavButtons();
  });

  document.querySelector('[data-sign-out]')?.addEventListener('click', async () => {
    await getSupabase().auth.signOut();
    window.location.replace('/admin');
  });
</script>
