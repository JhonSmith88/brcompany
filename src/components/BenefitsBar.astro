---
import BenefitIcon from './BenefitIcon.astro';
import { getHomeBenefits } from '../lib/home';

const items = (await getHomeBenefits()).slice(0, 3);
---

{
  items.length > 0 && (
    <section class="benefits" aria-label="Beneficios">
      <div class="container benefits__grid">
        {items.map((item) => (
          <div class="benefits__item">
            <span class="benefits__icon" aria-hidden="true">
              <BenefitIcon icon={item.icon} />
            </span>
            <div>
              <h2>{item.title}</h2>
              <p>{item.text}</p>
            </div>
          </div>
        ))}
      </div>
    </section>
  )
}

<style>
  .benefits {
    border-top: 1px solid rgb(201 162 39 / 0.14);
    background: #080808;
    padding-block: 2rem;
    margin-bottom: calc(-1 * var(--space-2xl));
  }

  .benefits__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .benefits__item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.45rem 1.2rem;
    min-width: 0;
  }

  .benefits__item:not(:last-child) {
    border-right: 1px solid rgb(200 200 200 / 0.18);
  }

  .benefits__icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    flex-shrink: 0;
    color: var(--color-gold);
  }

  .benefits__icon :global(svg) {
    width: 2rem;
    height: 2rem;
  }

  .benefits__item h2 {
    font-family: var(--font-body);
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-white);
    margin-bottom: 0.28rem;
    line-height: 1.25;
  }

  .benefits__item p {
    font-size: 0.95rem;
    color: var(--color-silver-dim);
    line-height: 1.35;
  }

  @media (max-width: 900px) {
    .benefits__grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .benefits__item {
      padding-inline: 0;
    }

    .benefits__item:not(:last-child) {
      border-right: none;
      border-bottom: 1px solid rgb(200 200 200 / 0.12);
      padding-bottom: 1rem;
    }
  }
</style>
