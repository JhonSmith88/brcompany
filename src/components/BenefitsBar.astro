---
interface Benefit {
  title: string;
  text: string;
  icon: 'lock' | 'whatsapp' | 'truck';
}

interface Props {
  items?: Benefit[];
}

const {
  items = [
    {
      title: 'Pago seguro',
      text: 'Transacciones protegidas.',
      icon: 'lock',
    },
    {
      title: 'Atención personalizada',
      text: 'Escríbenos por WhatsApp.',
      icon: 'whatsapp',
    },
    {
      title: 'Envíos a todo el país',
      text: 'Despacho seguro a tu ciudad.',
      icon: 'truck',
    },
  ],
} = Astro.props;
---

<section class="benefits" aria-label="Beneficios">
  <div class="container benefits__grid">
    {
      items.map((item) => (
        <div class="benefits__item">
          <span class="benefits__icon" aria-hidden="true">
            {item.icon === 'lock' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M8 11V8.2A4 4 0 0112 4.2 4 4 0 0116 8.2V11" stroke-linecap="round"></path>
                <rect x="5.5" y="11" width="13" height="8.8" rx="1.6"></rect>
                <path d="M12 14.2v2.2" stroke-linecap="round"></path>
              </svg>
            )}
            {item.icon === 'truck' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M3 7h11v9H3V7z"></path>
                <path d="M14 10h3.5L20 13v3h-6v-6z"></path>
                <circle cx="7.5" cy="17.5" r="1.5"></circle>
                <circle cx="17" cy="17.5" r="1.5"></circle>
              </svg>
            )}
            {item.icon === 'whatsapp' && (
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path
                  d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
                ></path>
              </svg>
            )}
          </span>
          <div>
            <h2>{item.title}</h2>
            <p>{item.text}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .benefits {
    border-top: 1px solid rgb(201 162 39 / 0.14);
    background: #080808;
    padding-block: 2rem;
    margin-bottom: calc(-1 * var(--space-2xl));
  }

  .benefits__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .benefits__item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.45rem 1.2rem;
    min-width: 0;
  }

  .benefits__item:not(:last-child) {
    border-right: 1px solid rgb(200 200 200 / 0.18);
  }

  .benefits__icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    flex-shrink: 0;
    color: var(--color-gold);
  }

  .benefits__icon svg {
    width: 2rem;
    height: 2rem;
  }

  .benefits__item h2 {
    font-family: var(--font-body);
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-white);
    margin-bottom: 0.28rem;
    line-height: 1.25;
  }

  .benefits__item p {
    font-size: 0.95rem;
    color: var(--color-silver-dim);
    line-height: 1.35;
  }

  @media (max-width: 900px) {
    .benefits__grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .benefits__item {
      padding-inline: 0;
    }

    .benefits__item:not(:last-child) {
      border-right: none;
      border-bottom: 1px solid rgb(200 200 200 / 0.12);
      padding-bottom: 1rem;
    }
  }
</style>
