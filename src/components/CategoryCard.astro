---
import type { Category } from '../data/categories';

interface Props {
  category: Category;
  count?: number;
}

const { category, count } = Astro.props;
---

<a class="cat" href={`/catalogo/${category.slug}`}>
  <div class="cat__media">
    <img
      src={category.imagenThumb || category.imagen}
      alt=""
      width="900"
      height="700"
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="cat__body">
    {
      typeof count === 'number' && (
        <span class="cat__count">{count} {count === 1 ? 'pieza' : 'piezas'}</span>
      )
    }
    <h3>{category.nombre}</h3>
    <p>{category.descripcion}</p>
    <span class="cat__cta">Ver Colección <span aria-hidden="true">→</span></span>
  </div>
</a>

<style>
  .cat {
    position: relative;
    display: block;
    aspect-ratio: 2 / 3;
    border: 1px solid rgba(201, 162, 39, 0.14);
    background: transparent;
    overflow: hidden;
    transition:
      border-color var(--transition),
      transform var(--transition);
  }

  .cat:hover {
    border-color: rgba(201, 162, 39, 0.45);
    transform: translateY(-3px);
  }

  .cat__media {
    position: absolute;
    inset: 0;
  }

  .cat__media::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to top,
      rgb(5 5 5 / 0.88) 0%,
      rgb(5 5 5 / 0.7) 22%,
      rgb(5 5 5 / 0.38) 38%,
      rgb(5 5 5 / 0.12) 52%,
      transparent 68%
    );
  }

  .cat__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .cat:hover .cat__media img {
    transform: scale(1.06);
  }

  .cat__body {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    padding: 1.35rem 1.25rem 1.4rem;
    background: transparent;
  }

  .cat__body h3 {
    font-size: 1.7rem;
    line-height: 1.12;
    margin-bottom: 0.35rem;
    color: var(--color-white);
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.55);
  }

  .cat__body p {
    color: var(--color-silver-bright);
    font-size: 0.98rem;
    line-height: 1.45;
    text-shadow: 0 1px 10px rgb(0 0 0 / 0.55);
  }

  .cat__count {
    display: block;
    margin-bottom: 0.45rem;
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-gold);
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.5);
  }

  .cat__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.9rem;
    font-size: 0.76rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-gold-bright);
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.5);
    transition: gap var(--transition);
  }

  .cat:hover .cat__cta {
    gap: 0.65rem;
  }
</style>
