---
interface Props {
  icon: string;
}

const { icon } = Astro.props;
---

{
  icon === 'truck' ? (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M3 7h11v9H3V7z"></path>
      <path d="M14 10h3.5L20 13v3h-6v-6z"></path>
      <circle cx="7.5" cy="17.5" r="1.5"></circle>
      <circle cx="17" cy="17.5" r="1.5"></circle>
    </svg>
  ) : icon === 'badge' ? (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <circle cx="12" cy="14" r="5.25"></circle>
      <circle cx="12" cy="14" r="2.4"></circle>
      <path d="M9.4 9.4L8 3.5l4 2.2 4-2.2-1.4 5.9" stroke-linejoin="round"></path>
    </svg>
  ) : icon === 'whatsapp' ? (
    <svg viewBox="0 0 24 24" fill="currentColor">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path>
    </svg>
  ) : icon === 'gear' ? (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <circle cx="12" cy="12" r="3.2"></circle>
      <path d="M19.4 13.5a7.6 7.6 0 000-3l1.8-1.1-1.8-3.1-2.1.5a7.7 7.7 0 00-2.6-1.5L14.2 3h-4.4L9.3 5.3a7.7 7.7 0 00-2.6 1.5l-2.1-.5-1.8 3.1L4.6 10.5a7.6 7.6 0 000 3L2.8 14.6l1.8 3.1 2.1-.5a7.7 7.7 0 002.6 1.5L9.8 21h4.4l.5-2.3a7.7 7.7 0 002.6-1.5l2.1.5 1.8-3.1-1.8-1.1z"></path>
    </svg>
  ) : icon === 'diamond' ? (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M4.8 9.2L12 20.5 19.2 9.2 15.4 4.5H8.6L4.8 9.2z"></path>
      <path d="M4.8 9.2h14.4M8.6 4.5l-1 4.7 4.4 11.3M15.4 4.5l1 4.7-4.4 11.3"></path>
    </svg>
  ) : icon === 'water' ? (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M12 4c3.6 4.2 6 7.4 6 10.2A6 6 0 0112 20a6 6 0 01-6-5.8C6 11.4 8.4 8.2 12 4z"></path>
    </svg>
  ) : icon === 'star' ? (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M12 3.2L14.4 8l5.4.7-4 3.7.9 5.4L12 15.6 7.3 17.8l.9-5.4-4-3.7L9.6 8 12 3.2z" stroke-linejoin="round"></path>
    </svg>
  ) : icon === 'user' ? (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <circle cx="12" cy="8" r="3.1"></circle>
      <path d="M6.2 19c.7-3.1 3-4.8 5.8-4.8s5.1 1.7 5.8 4.8" stroke-linecap="round"></path>
    </svg>
  ) : (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M12 3l7 3v5c0 4.4-2.9 7.7-7 9-4.1-1.3-7-4.6-7-9V6l7-3z"></path>
      <path d="M9.2 12.1l1.9 1.9 3.8-4" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  )
}
