---
interface Props {
  icon: string;
}

const { icon } = Astro.props;
---

{
  icon === 'bracelet' ? (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <ellipse cx="12" cy="12" rx="7" ry="4.2"></ellipse>
      <path d="M5.2 12c1.2 3.6 3.8 5.8 6.8 5.8S17.6 15.6 18.8 12" stroke-linecap="round"></path>
    </svg>
  ) : icon === 'wallet' ? (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <rect x="3.5" y="7" width="17" height="11" rx="1.6"></rect>
      <path d="M3.5 10h17M16.2 13.6h2.2" stroke-linecap="round"></path>
    </svg>
  ) : icon === 'scent' ? (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M10 4h4l.8 3.2H9.2L10 4zM9.2 7.2h5.6V19a2 2 0 01-2 2h-1.6a2 2 0 01-2-2V7.2z"></path>
    </svg>
  ) : (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <circle cx="12" cy="13" r="6.2"></circle>
      <path d="M9 7.2V4.8h6V7.2M12 13l2.1-1.4M9.2 3.8h5.6" stroke-linecap="round"></path>
    </svg>
  )
}
