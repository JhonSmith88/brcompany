---
import { site, buildWhatsAppUrl, generalWhatsAppMessage } from '../data/site';
import { getContactPageCopy } from '../lib/contact-page';
import { getSiteSettings } from '../lib/site-settings';

const settings = await getSiteSettings();
const contact = await getContactPageCopy();
const waUrl = buildWhatsAppUrl(generalWhatsAppMessage(), settings.whatsappNumber);
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__inner container">
    <div class="footer__brand">
      <img src="/logo.png" alt="" width="72" height="72" class="footer__logo" />
      <div>
        <p class="footer__name">{site.name}</p>
        <p class="footer__tag">{site.tagline}</p>
        <p class="footer__desc">
          Catálogo de lujo para hombres. Consulta disponibilidad y realiza tu pedido por WhatsApp.
        </p>
        <div class="footer__social">
          {settings.instagramUrl && (
            <a href={settings.instagramUrl} aria-label="Instagram" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <rect x="3.5" y="3.5" width="17" height="17" rx="4.5"></rect>
                <circle cx="12" cy="12" r="4"></circle>
                <circle cx="17.4" cy="6.6" r="0.9" fill="currentColor" stroke="none"></circle>
              </svg>
            </a>
          )}
          {settings.facebookUrl && (
            <a href={settings.facebookUrl} aria-label="Facebook" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
                <path d="M14.2 8.5V6.8c0-.7.5-1.3 1.2-1.3h1.1V3h-2.1C11.8 3 10.5 4.5 10.5 6.8v1.7H8.5V11h2v10h3.2V11h2.2l.5-2.5h-2.7z"></path>
              </svg>
            </a>
          )}
          <a href={waUrl} aria-label="WhatsApp" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.87 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <div class="footer__cols">
      <div>
        <h3>Explorar</h3>
        <ul>
          <li><a href="/">Inicio</a></li>
          <li><a href="/quienes-somos">Quiénes somos</a></li>
          <li><a href="/catalogo">Catálogo</a></li>
          <li><a href="/contacto">Contacto</a></li>
        </ul>
      </div>
      <div>
        <h3>Pedidos</h3>
        <ul>
          <li><a href={waUrl} target="_blank" rel="noopener noreferrer">WhatsApp {settings.whatsappDisplay}</a></li>
          <li><a href={`mailto:${settings.email}`}>{settings.email}</a></li>
          <li>{contact.location}</li>
        </ul>
      </div>
    </div>
  </div>

  <div class="footer__bottom container">
    <p>© {year} {site.name}. Todos los derechos reservados.</p>
    <p>Sin pasarela de pago · Atención personalizada</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--space-2xl);
    border-top: 1px solid rgba(201, 162, 39, 0.14);
    background: linear-gradient(180deg, transparent, rgba(20, 20, 20, 0.6));
    padding-top: var(--space-xl);
  }

  .footer__inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-xl);
    padding-bottom: var(--space-xl);
  }

  .footer__brand {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .footer__logo {
    width: 4.5rem;
    height: 4.5rem;
    object-fit: contain;
    flex-shrink: 0;
  }

  .footer__name {
    font-family: var(--font-display);
    font-size: 1.6rem;
    letter-spacing: 0.14em;
    color: var(--color-gold-bright);
    text-transform: uppercase;
  }

  .footer__tag {
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-silver-dim);
    margin-bottom: 0.75rem;
  }

  .footer__desc {
    max-width: 28rem;
    color: var(--color-silver-dim);
    font-size: 0.95rem;
    margin-bottom: 1rem;
  }

  .footer__social {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .footer__social a {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    color: var(--color-white);
    transition: color var(--transition);
  }

  .footer__social a:hover {
    color: var(--color-gold-bright);
  }

  .footer__cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
  }

  .footer__cols h3 {
    font-family: var(--font-body);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 1rem;
  }

  .footer__cols li + li {
    margin-top: 0.55rem;
  }

  .footer__cols a {
    color: var(--color-silver);
    transition: color var(--transition);
  }

  .footer__cols a:hover {
    color: var(--color-gold-bright);
  }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-block: 1.25rem;
    border-top: 1px solid rgba(200, 200, 200, 0.08);
    font-size: 0.8rem;
    color: var(--color-silver-dim);
  }

  @media (max-width: 800px) {
    .footer__inner {
      grid-template-columns: 1fr;
    }

    .footer__cols {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
