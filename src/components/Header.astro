---
import { site } from '../data/site';

const pathname = Astro.url.pathname;
const links = [
  { href: '/', label: 'Inicio' },
  { href: '/quienes-somos', label: 'Quiénes somos' },
  { href: '/catalogo', label: 'Catálogo' },
  { href: '/contacto', label: 'Contacto' },
];

function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(`${href}/`);
}
---

<header class="header">
  <div class="header__inner container">
    <a class="header__brand" href="/" aria-label={`${site.name} inicio`}>
      <img src="/logo.png" alt={site.name} width="52" height="52" class="header__logo" />
      <span class="header__wordmark">
        <span class="header__name">{site.name}</span>
        <span class="header__tag">Relojes & Accesorios</span>
      </span>
    </a>

    <div class="header__right">
      <nav class="header__nav" id="site-nav" data-nav>
        <ul>
          {
            links.map((link) => (
              <li>
                <a href={link.href} class:list={[{ 'is-active': isActive(link.href) }]}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="header__tools">
        <button
          type="button"
          class="header__icon header__bag"
          aria-label="Bolsa de compra"
          aria-expanded="false"
          aria-controls="cart-drawer"
          data-bag-toggle
        >
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M7 8.5h10l1.2 11.2a1 1 0 01-1 1.1H6.8a1 1 0 01-1-1.1L7 8.5z" stroke-linejoin="round"></path>
            <path d="M9 10V7.8a3 3 0 016 0V10" stroke-linecap="round"></path>
            <path d="M9 8.5c1.2 1.4 4.8 1.4 6 0" stroke-linecap="round"></path>
          </svg>
          <span class="header__bag-count" data-bag-count hidden>0</span>
        </button>
      </div>

      <button
        class="header__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-nav"
        data-nav-toggle
      >
        <span class="sr-only">Abrir menú</span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--nav-height);
    border-bottom: 1px solid rgba(201, 162, 39, 0.14);
    background: rgba(5, 5, 5, 0.86);
    backdrop-filter: blur(14px);
  }

  .header__inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .header__brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .header__logo {
    width: 3.35rem;
    height: 3.35rem;
    object-fit: contain;
  }

  .header__wordmark {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .header__name {
    font-family: var(--font-display);
    font-size: 1.55rem;
    letter-spacing: 0.12em;
    color: var(--color-gold-bright);
    text-transform: uppercase;
  }

  .header__tag {
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-white);
  }

  .header__right {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .header__nav ul {
    display: flex;
    align-items: center;
    gap: 1.9rem;
  }

  .header__nav a {
    font-size: 0.84rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-silver);
    position: relative;
    padding-bottom: 0.2rem;
    transition: color var(--transition);
  }

  .header__nav a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: var(--gold-gradient);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--transition);
  }

  .header__nav a:hover,
  .header__nav a.is-active {
    color: var(--color-gold-bright);
  }

  .header__nav a.is-active::after,
  .header__nav a:hover::after {
    transform: scaleX(1);
  }

  .header__tools {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    padding-left: 0.35rem;
    border-left: 1px solid rgba(201, 162, 39, 0.2);
  }

  .header__icon {
    display: grid;
    place-items: center;
    width: 2.65rem;
    height: 2.65rem;
    color: var(--color-silver);
    transition: color var(--transition);
  }

  .header__icon:hover {
    color: var(--color-gold-bright);
  }

  .header__bag {
    position: relative;
  }

  .header__bag-count {
    position: absolute;
    top: 0.32rem;
    right: 0.28rem;
    min-width: 1.05rem;
    height: 1.05rem;
    padding: 0 0.22rem;
    border-radius: 999px;
    background: var(--gold-gradient);
    color: var(--color-black);
    font-size: 0.58rem;
    font-weight: 600;
    line-height: 1.05rem;
    text-align: center;
  }

  .header__toggle {
    display: none;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    gap: 6px;
    flex-direction: column;
  }

  .header__toggle span {
    display: block;
    width: 1.35rem;
    height: 1px;
    background: var(--color-gold);
    transition: transform var(--transition), opacity var(--transition);
  }

  @media (max-width: 800px) {
    .header__tag {
      display: none;
    }

    .header__toggle {
      display: flex;
    }

    .header__tools {
      border-left: none;
      padding-left: 0;
    }

    .header__nav {
      position: fixed;
      inset: var(--nav-height) 0 auto 0;
      background: rgba(8, 8, 8, 0.98);
      border-bottom: 1px solid rgba(201, 162, 39, 0.18);
      padding: 1.25rem 1rem 1.5rem;
      transform: translateY(-120%);
      opacity: 0;
      pointer-events: none;
      transition:
        transform var(--transition),
        opacity var(--transition);
    }

    .header__nav.is-open {
      transform: translateY(0);
      opacity: 1;
      pointer-events: auto;
    }

    .header__nav ul {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.1rem;
    }

    .header.is-open .header__toggle span:first-child {
      transform: translateY(3.5px) rotate(45deg);
    }

    .header.is-open .header__toggle span:last-child {
      transform: translateY(-3.5px) rotate(-45deg);
    }
  }
</style>

<script>
  const header = document.querySelector('.header');
  const toggle = document.querySelector('[data-nav-toggle]');
  const nav = document.querySelector('[data-nav]');

  toggle?.addEventListener('click', () => {
    const open = header?.classList.toggle('is-open');
    nav?.classList.toggle('is-open', Boolean(open));
    toggle.setAttribute('aria-expanded', String(Boolean(open)));
  });

  nav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      header?.classList.remove('is-open');
      nav.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
